<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_fleet_trip_form" model="ir.ui.view">
        <field name="name">lhi.fleet.trip.form</field>
        <field name="model">lhi.fleet.trip</field>
        <field name="arch" type="xml">
            <form string="Trip Request">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'submitted'"/>
                    <button name="action_start" string="Start Trip" type="object" class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="action_done" string="Complete Trip" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('done', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Who">
                            <field name="traveller_id" readonly="state != 'draft'"/>
                            <field name="driver_id" readonly="state != 'draft'"/>
                            <field name="vehicle_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Where &amp; When">
                            <field name="location_from" readonly="state != 'draft'"/>
                            <field name="location_to" readonly="state != 'draft'"/>
                            <field name="date_start" readonly="state != 'draft'"/>
                            <field name="date_end" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Purpose &amp; Coding">
                            <group>
                                <field name="purpose" readonly="state != 'draft'"/>
                                <field name="lhi_project_id" readonly="state != 'draft'"/>
                                <field name="lhi_activity_id" readonly="state != 'draft'"/>
                            </group>
                        </page>
                        <page string="Logistics &amp; Security">
                            <group>
                                <field name="expected_distance" readonly="state != 'draft'"/>
                                <field name="security_requirements" readonly="state != 'draft'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_lhi_fleet_trip_tree" model="ir.ui.view">
        <field name="name">lhi.fleet.trip.tree</field>
        <field name="model">lhi.fleet.trip</field>
        <field name="arch" type="xml">
            <list string="Trips">
                <field name="name"/>
                <field name="traveller_id"/>
                <field name="vehicle_id"/>
                <field name="location_from"/>
                <field name="location_to"/>
                <field name="date_start"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    
    <!-- Action handled in menu_views.xml -->
</odoo>
