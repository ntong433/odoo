<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_lhi_purchase_order" model="ir.sequence">
            <field name="name">Purchase Order</field>
            <field name="code">lhi.purchase.order</field>
            <field name="prefix">PO/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_lhi_receipt" model="ir.sequence">
            <field name="name">Receipt</field>
            <field name="code">lhi.receipt</field>
            <field name="prefix">REC/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
