<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_integration_connection_form" model="ir.ui.view">
        <field name="name">lhi.integration.connection.form</field>
        <field name="model">lhi.integration.connection</field>
        <field name="arch" type="xml">
            <form string="Integration Connection">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="provider"/>
                            <field name="auth_type"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="base_url"/>
                            <field name="client_id" invisible="auth_type != 'oauth2'"/>
                            <field name="tenant_id" invisible="provider != 'microsoft_graph'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Credentials">
                            <group>
                                <!-- password widget masks the input -->
                                <field name="client_secret" password="True"/>
                            </group>
                            <div class="alert alert-warning" role="alert">
                                Warning: Avoid storing plain text credentials in the database if possible.
                                Ensure database backups are properly secured.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_lhi_integration_connection_tree" model="ir.ui.view">
        <field name="name">lhi.integration.connection.list</field>
        <field name="model">lhi.integration.connection</field>
        <field name="arch" type="xml">
            <list string="Integration Connections">
                <field name="name"/>
                <field name="provider"/>
                <field name="base_url"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_lhi_integration_connection" model="ir.actions.act_window">
        <field name="name">API Connections</field>
        <field name="res_model">lhi.integration.connection</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
