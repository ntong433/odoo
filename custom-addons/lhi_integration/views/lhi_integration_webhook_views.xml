<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_integration_webhook_form" model="ir.ui.view">
        <field name="name">lhi.integration.webhook.form</field>
        <field name="model">lhi.integration.webhook</field>
        <field name="arch" type="xml">
            <form string="Inbound Webhook">
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="source_system"/>
                            <field name="event_type"/>
                        </group>
                        <group>
                            <field name="idempotency_key"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload">
                            <field name="payload" widget="text"/>
                        </page>
                        <page string="Error" invisible="state != 'error'">
                            <field name="error_message" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_lhi_integration_webhook_tree" model="ir.ui.view">
        <field name="name">lhi.integration.webhook.list</field>
        <field name="model">lhi.integration.webhook</field>
        <field name="arch" type="xml">
            <list string="Inbound Webhooks" decoration-danger="state=='error'" decoration-muted="state=='ignored'" decoration-success="state=='processed'">
                <field name="source_system"/>
                <field name="event_type"/>
                <field name="idempotency_key"/>
                <field name="state" widget="badge"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="action_lhi_integration_webhook" model="ir.actions.act_window">
        <field name="name">Inbound Webhooks</field>
        <field name="res_model">lhi.integration.webhook</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
