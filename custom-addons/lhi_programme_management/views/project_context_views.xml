<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_project_programme_context" model="ir.ui.view">
        <field name="name">lhi.project.programme.context</field>
        <field name="model">lhi.project</field>
        <field name="inherit_id" ref="lhi_base.view_lhi_project_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <notebook name="programmes_grants_context">
                    <page string="Budgets">
                        <field name="programme_budget_ids" readonly="1"/>
                    </page>
                    <page string="Execution Requests">
                        <field name="execution_request_ids" readonly="1"/>
                    </page>
                    <page string="Retirements">
                        <field name="payment_retirement_ids" readonly="1"/>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
    <record id="view_workplan_activity_programme_context" model="ir.ui.view">
        <field name="name">lhi.workplan.activity.programme.context</field>
        <field name="model">lhi.workplan.activity</field>
        <field name="inherit_id" ref="lhi_project_workplan.view_lhi_workplan_activity_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Budget Allocations">
                    <field name="programme_allocation_ids" readonly="1"/>
                </page>
                <page string="Requests">
                    <field name="execution_request_ids" readonly="1"/>
                </page>
                <page string="Retirements">
                    <field name="payment_retirement_ids" readonly="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
