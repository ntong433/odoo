<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_lhi_inherit" model="ir.ui.view">
        <field name="name">stock.picking.form.lhi.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="lhi_project_id"/>
                <field name="lhi_donor_id"/>
            </xpath>
            <xpath expr="//field[@name='move_ids']/list/field[@name='product_id']" position="after">
                <field name="lhi_project_id" optional="show"/>
                <field name="lhi_donor_id" optional="hide"/>
                <field name="lhi_activity_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
