<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Prevent ordinary users from messing with integration endpoints -->
        <record id="lhi_integration_connection_rule" model="ir.rule">
            <field name="name">LHI Integration Connection Admin</field>
            <field name="model_id" ref="model_lhi_integration_connection"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
        </record>

        <record id="lhi_integration_job_rule_admin" model="ir.rule">
            <field name="name">LHI Integration Job Admin</field>
            <field name="model_id" ref="model_lhi_integration_job"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
        </record>
        
        <record id="lhi_integration_webhook_rule_admin" model="ir.rule">
            <field name="name">LHI Integration Webhook Admin</field>
            <field name="model_id" ref="model_lhi_integration_webhook"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
        </record>
    </data>
</odoo>
