<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. The Owl Client Action -->
    <record id="action_lhi_dashboard" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">lhi_dashboard.main</field>
        <field name="target">main</field>
    </record>

    <!-- 2. The Main Menu Item (Sequence 1 so it loads first after login) -->
    <menuitem id="menu_lhi_dashboard_root"
              name="Dashboard"
              action="action_lhi_dashboard"
              sequence="1"
              web_icon="lhi_dashboard,static/description/icon.png"/>

    <!-- 3. Admin Menus for Configuration -->
    <menuitem id="menu_lhi_dashboard_config"
              name="Dashboard Settings"
              parent="base.menu_custom"
              sequence="50"/>

    <menuitem id="menu_lhi_dashboard_widgets"
              name="Dashboard Widgets"
              parent="menu_lhi_dashboard_config"
              action="action_lhi_dashboard_widget"
              sequence="10"/>
              
    <menuitem id="menu_lhi_dashboard_announcements"
              name="Announcements"
              parent="menu_lhi_dashboard_config"
              action="action_lhi_announcement"
              sequence="20"/>
</odoo>
