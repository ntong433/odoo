<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_dashboard_widget_form" model="ir.ui.view">
        <field name="name">lhi.dashboard.widget.form</field>
        <field name="model">lhi.dashboard.widget</field>
        <field name="arch" type="xml">
            <form string="Dashboard Widget">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="registry_key"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="col_span"/>
                            <field name="active"/>
                            <field name="app_key"/>
                            <field name="is_public_internal"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Access Rights">
                            <field name="group_ids" widget="many2many_tags"/>
                            <p class="text-muted">
                                Empty access configuration is fail-closed. Select an application,
                                explicit internal visibility, or one or more groups.
                            </p>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_lhi_dashboard_widget_tree" model="ir.ui.view">
        <field name="name">lhi.dashboard.widget.tree</field>
        <field name="model">lhi.dashboard.widget</field>
        <field name="arch" type="xml">
            <list string="Dashboard Widgets" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="registry_key"/>
                <field name="col_span"/>
                <field name="app_key" optional="show"/>
                <field name="is_public_internal" optional="show"/>
                <field name="group_ids" widget="many2many_tags"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_lhi_dashboard_widget" model="ir.actions.act_window">
        <field name="name">Dashboard Widgets</field>
        <field name="res_model">lhi.dashboard.widget</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
