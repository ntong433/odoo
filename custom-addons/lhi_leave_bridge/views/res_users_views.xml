<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_lhi_leave" model="ir.ui.view">
        <field name="name">res.users.form.lhi.leave</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="after">
                <page string="External Identity Mapping">
                    <group>
                        <field name="lhi_entra_object_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
