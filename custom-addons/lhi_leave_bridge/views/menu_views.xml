<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_lhi_unified_inbox_root" name="Unified Inbox" sequence="1" web_icon="lhi_leave_bridge,static/description/icon.png"/>

    <record id="action_lhi_unified_inbox" model="ir.actions.act_window">
        <field name="name">My Approvals</field>
        <field name="res_model">lhi.unified.inbox</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status', '=', 'pending')]</field>
    </record>
    
    <record id="action_lhi_leave_cache" model="ir.actions.act_window">
        <field name="name">Leave Balances</field>
        <field name="res_model">lhi.leave.cache</field>
        <field name="view_mode">list</field>
    </record>
    
    <record id="action_lhi_leave_request_cache" model="ir.actions.act_window">
        <field name="name">Staff On Leave</field>
        <field name="res_model">lhi.leave.request.cache</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_lhi_unified_inbox" name="My Approvals" parent="menu_lhi_unified_inbox_root" action="action_lhi_unified_inbox" sequence="10"/>
    
    <menuitem id="menu_lhi_leave_root" name="Leave Management" sequence="2" web_icon="lhi_leave_bridge,static/description/icon.png"/>
    <menuitem id="menu_lhi_leave_balances" name="Balances" parent="menu_lhi_leave_root" action="action_lhi_leave_cache" sequence="10"/>
    <menuitem id="menu_lhi_leave_staff" name="Staff On Leave" parent="menu_lhi_leave_root" action="action_lhi_leave_request_cache" sequence="20"/>
</odoo>
