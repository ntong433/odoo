<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_integration_job_form" model="ir.ui.view">
        <field name="name">lhi.integration.job.form</field>
        <field name="model">lhi.integration.job</field>
        <field name="arch" type="xml">
            <form string="Integration Job">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="pending,running,done,failed,dead_letter"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model_name"/>
                            <field name="record_id"/>
                            <field name="action"/>
                        </group>
                        <group>
                            <field name="retry_count"/>
                            <field name="max_retries"/>
                            <field name="next_retry"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Last Error" invisible="not last_error">
                            <field name="last_error" widget="text"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_lhi_integration_job_tree" model="ir.ui.view">
        <field name="name">lhi.integration.job.list</field>
        <field name="model">lhi.integration.job</field>
        <field name="arch" type="xml">
            <list string="Integration Jobs" decoration-danger="state in ('failed','dead_letter')" decoration-info="state=='pending'" decoration-success="state=='done'">
                <field name="name"/>
                <field name="model_name"/>
                <field name="action"/>
                <field name="state" widget="badge"/>
                <field name="retry_count"/>
                <field name="next_retry"/>
            </list>
        </field>
    </record>

    <record id="action_lhi_integration_job" model="ir.actions.act_window">
        <field name="name">Integration Jobs</field>
        <field name="res_model">lhi.integration.job</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
