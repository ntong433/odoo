<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_leave_cache_tree" model="ir.ui.view">
        <field name="name">lhi.leave.cache.tree</field>
        <field name="model">lhi.leave.cache</field>
        <field name="arch" type="xml">
            <list string="Leave Balances">
                <field name="user_id"/>
                <field name="annual_balance"/>
                <field name="sick_balance"/>
                <field name="is_stale" widget="boolean_toggle"/>
                <field name="last_sync_date"/>
            </list>
        </field>
    </record>

    <record id="view_lhi_leave_request_cache_tree" model="ir.ui.view">
        <field name="name">lhi.leave.request.cache.tree</field>
        <field name="model">lhi.leave.request.cache</field>
        <field name="arch" type="xml">
            <list string="Staff On Leave">
                <field name="user_id"/>
                <field name="leave_type"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>
</odoo>
