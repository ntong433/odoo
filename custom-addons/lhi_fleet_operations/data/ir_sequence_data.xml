<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_lhi_fleet_trip" model="ir.sequence">
            <field name="name">Trip Reference</field>
            <field name="code">lhi.fleet.trip</field>
            <field name="prefix">TRP/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_lhi_fleet_incident" model="ir.sequence">
            <field name="name">Incident Reference</field>
            <field name="code">lhi.fleet.incident</field>
            <field name="prefix">INC/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
