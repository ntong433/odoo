<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_lhi_entra" model="ir.ui.view">
        <field name="name">res.users.form.lhi.entra</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='access_rights']" position="after">
                <page string="Identity &amp; Integration" name="lhi_integration">
                    <group>
                        <field name="lhi_entra_object_id"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
