<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Override the web login layout for a split-screen enterprise look -->
    <template id="lhi_login_layout_override" inherit_id="web.login_layout">
        <xpath expr="//div[@class='container py-5']" position="attributes">
            <attribute name="class">container-fluid p-0 lhi-login-host</attribute>
        </xpath>
        <xpath expr="//div[contains(@t-attf-class, 'card')]" position="replace">
            <main class="lhi-login-page">
                <section class="lhi-login-visual" aria-label="Life Helpers Initiative">
                    <div class="lhi-login-branding">
                        <img src="/web/binary/company_logo"
                             alt="LHI Nigeria Logo"
                             class="lhi-login-logo"/>
                        <h1>Life Helpers Initiative</h1>
                        <p>Enterprise Resource Planning &amp; Management System</p>
                    </div>
                </section>
                <section class="lhi-login-panel">
                    <div class="lhi-login-card">
                        <header class="lhi-login-header">
                            <h2>Welcome Back</h2>
                            <p>Sign in to continue to LHI ERP</p>
                        </header>
                        <t t-out="0"/>
                    </div>
                </section>
            </main>
        </xpath>
    </template>

    <!-- Override the web login form -->
    <template id="lhi_login_override" inherit_id="web.login">
        <xpath expr="//form" position="replace">
            <form class="oe_login_form lhi_login_form" role="form" t-attf-action="/web/login" method="post" onsubmit="this.action = '/web/login' + location.hash">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <div class="mb-3 field-login">
                    <label for="login" class="form-label">Email / Username</label>
                    <input type="text" placeholder="name@lhinigeria.org" name="login" t-att-value="login" id="login" class="form-control" required="required" autofocus="autofocus" autocapitalize="off"/>
                </div>

                <div class="mb-3 field-password">
                    <label for="password" class="form-label d-flex justify-content-between">
                        <span>Password</span>
                        <a t-if="reset_password_enabled" t-attf-href="/web/reset_password?{{ keep_query() }}" class="lhi-forgot-password">Forgot password?</a>
                    </label>
                    <div class="input-group">
                        <input type="password" placeholder="••••••••" name="password" id="password" class="form-control" required="required" autocomplete="current-password" t-att-autofocus="'autofocus' if login else None" maxlength="4096"/>
                        <button class="btn btn-outline-secondary o_show_password" type="button">
                            <i class="fa fa-eye"></i>
                        </button>
                    </div>
                </div>

                <p class="alert alert-danger" t-if="error" role="alert">
                    <t t-esc="error"/>
                </p>
                <p class="alert alert-success" t-if="message" role="status">
                    <t t-esc="message"/>
                </p>

                <div class="d-grid mt-4">
                    <button type="submit" class="btn btn-primary lhi-btn-primary">Sign in</button>
                </div>
                
                <input type="hidden" name="redirect" t-att-value="redirect"/>
            </form>

            <div class="lhi-login-divider"><span>or</span></div>

            <t t-set="oauth_available" t-value="False"/>
            <t t-foreach="providers or []" t-as="provider">
                <t t-if="provider.get('enabled')
                         and provider.get('auth_link')
                         and provider.get('client_id')
                         and 'PLACEHOLDER' not in provider.get('client_id').upper()
                         and provider.get('auth_endpoint')
                         and '/common/' not in provider.get('auth_endpoint')">
                    <t t-set="oauth_available" t-value="True"/>
                    <a t-att-href="provider.get('auth_link')"
                       class="lhi-microsoft-button">
                        <i class="fa fa-windows"/>
                        <span>Sign in with Microsoft</span>
                    </a>
                </t>
            </t>

            <div t-if="not oauth_available"
                 class="alert alert-warning lhi-login__oauth-unavailable"
                 role="status">
                <t t-if="debug">
                    Microsoft OAuth provider is disabled or its client ID or
                    tenant-specific authorization endpoint is invalid.
                </t>
                <t t-else="">
                    Microsoft sign-in is temporarily unavailable.
                    Please contact the LHI IT Helpdesk.
                </t>
            </div>

            <p class="lhi-login-help">
                Need help? Contact the LHI IT Helpdesk.
            </p>
        </xpath>
    </template>
</odoo>
