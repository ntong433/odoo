<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Activities -->
    <record id="metric_total_activities" model="lhi.project.dashboard.metric">
        <field name="name">Total Activities</field>
        <field name="code">activities_total</field>
        <field name="section">Activities</field>
        <field name="metric_type">automatic</field>
        <field name="automatic_code">activities_total</field>
        <field name="unit">number</field>
        <field name="sequence">10</field>
        <field name="default_for_projects">1</field>
    </record>

    <record id="metric_completed_activities" model="lhi.project.dashboard.metric">
        <field name="name">Completed Activities</field>
