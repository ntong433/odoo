        </record>

        <!-- Department Restriction for LHI Employees -->
        <record id="rule_lhi_department_employee_restriction" model="ir.rule">
            <field name="name">LHI Department Employee Restriction</field>
            <field name="model_id" ref="lhi_base.model_lhi_department"/>
            <field name="groups" eval="[(4, ref('group_lhi_employee'))]"/>
            <field name="domain_force">['|', ('id', 'in', user.lhi_department_ids.ids), ('parent_id', 'child_of', user.lhi_department_ids.ids)] if user.lhi_department_ids else [(1, '=', 1)]</field>
        </record>

        <!-- Department Bypass for LHI Managers -->
        <record id="rule_lhi_department_manager_bypass" model="ir.rule">
            <field name="name">LHI Department Manager Bypass</field>
            <field name="model_id" ref="lhi_base.model_lhi_department"/>
