<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_programme_context" model="ir.ui.view">
        <field name="name">lhi.purchase.request.programme.context</field>
        <field name="model">lhi.purchase.request</field>
        <field name="inherit_id" ref="lhi_purchase_request.view_lhi_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='activity_id']" position="after">
                <field name="work_context"/>
                <field name="workplan_activity_id" invisible="work_context != 'project_linked'"/>
                <field name="memo_id" invisible="work_context != 'project_linked'"/>
                <field name="project_budget_line_id" invisible="work_context != 'project_linked'"/>
                <field name="enterprise_payment_reference" groups="lhi_programme_management.group_lhi_programmes_finance_reviewer"/>
            </xpath>
        </field>
    </record>

    <record id="view_fleet_trip_programme_context" model="ir.ui.view">
        <field name="name">lhi.fleet.trip.programme.context</field>
        <field name="model">lhi.fleet.trip</field>
        <field name="inherit_id" ref="lhi_fleet_operations.view_lhi_fleet_trip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lhi_activity_id']" position="after">
                <field name="work_context"/>
                <field name="grant_id" invisible="work_context != 'project_linked'"/>
                <field name="memo_id" invisible="work_context != 'project_linked'"/>
                <field name="project_budget_line_id" invisible="work_context != 'project_linked'"/>
            </xpath>
        </field>
    </record>

    <record id="view_media_request_programme_context" model="ir.ui.view">
        <field name="name">lhi.media.request.programme.context</field>
        <field name="model">lhi.media.request</field>
        <field name="inherit_id" ref="lhi_media_communications.view_lhi_media_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='links']/group" position="inside">
                <field name="work_context"/>
                <field name="memo_id" invisible="work_context != 'project_linked'"/>
                <field name="project_budget_line_id" invisible="work_context != 'project_linked'"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_submit" string="Submit" type="object" class="oe_highlight" invisible="state not in ('draft', 'revision')"/>
            </xpath>
        </field>
    </record>

    <record id="view_meal_data_programme_context" model="ir.ui.view">
        <field name="name">lhi.meal.data.programme.context</field>
        <field name="model">lhi.meal.data</field>
        <field name="inherit_id" ref="lhi_meal.view_lhi_meal_data_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_id']" position="after">
                <field name="work_context"/>
                <field name="grant_id" invisible="work_context != 'project_linked'"/>
                <field name="memo_id" invisible="work_context != 'project_linked'"/>
                <field name="project_budget_line_id" invisible="work_context != 'project_linked'"/>
            </xpath>
        </field>
    </record>

    <record id="view_meal_initiative_programme_context" model="ir.ui.view">
        <field name="name">lhi.meal.initiative.programme.context</field>
        <field name="model">lhi.meal.initiative</field>
        <field name="inherit_id" ref="lhi_meal.view_lhi_meal_initiative_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='activity_id']" position="after">
                <field name="memo_id" invisible="work_context != 'project_linked'"/>
                <field name="project_budget_line_id" invisible="work_context != 'project_linked'"/>
            </xpath>
        </field>
    </record>

    <record id="view_asset_programme_context" model="ir.ui.view">
        <field name="name">lhi.asset.programme.context</field>
        <field name="model">lhi.asset</field>
        <field name="inherit_id" ref="lhi_asset_management.view_lhi_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_id']" position="after">
                <field name="work_context"/>
                <field name="award_id" invisible="work_context != 'project_linked'"/>
                <field name="workplan_activity_id" invisible="work_context != 'project_linked'"/>
                <field name="memo_id" invisible="work_context != 'project_linked'"/>
                <field name="project_budget_line_id" invisible="work_context != 'project_linked'"/>
            </xpath>
        </field>
    </record>
</odoo>
