<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lhi_dashboard.OperationsHub" owl="1">
        <div class="lhi-operations-hub container mt-4">
            <div class="row">
                <div class="col-12 mb-4">
                    <h2 class="text-primary">Operations Hub</h2>
                    <p class="text-muted">Select an operational area below to manage its processes.</p>
                </div>
            </div>
            
            <div class="row" t-if="state.loading">
                <div class="col-12 text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
            
            <div class="row" t-elif="state.error">
                <div class="col-12">
                    <div class="alert alert-danger">
                        Failed to load operations. Please try again later.
                    </div>
                </div>
            </div>

            <div class="row" t-elif="state.modules.length > 0">
                <t t-foreach="state.modules" t-as="module" t-key="module.key">
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="card h-100 shadow-sm cursor-pointer lhi-dashboard-card" t-on-click="() => this.onModuleClick(module)">
                            <div class="card-body text-center d-flex flex-column align-items-center justify-content-center">
                                <div class="lhi-module-icon-wrapper mb-3" style="width: 80px; height: 80px; background-color: #f8f9fa; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                    <img t-if="module.icon" t-att-src="module.icon" class="img-fluid" style="max-height: 50px;" alt="Icon"/>
                                    <i t-else="" class="fa fa-cogs fa-3x text-secondary"></i>
                                </div>
                                <h4 class="card-title text-dark"><t t-esc="module.name"/></h4>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
            <div class="row" t-else="">
                <div class="col-12">
                    <div class="alert alert-info">
                        You do not have access to any operational areas. Please contact your administrator.
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>
