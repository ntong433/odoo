<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="lhi_security.group_lhi_fleet_officer" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('fleet.fleet_group_user'))]"/>
        </record>
        <record id="lhi_security.group_lhi_fleet_manager" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('fleet.fleet_group_manager'))]"/>
        </record>
    </data>
    <data noupdate="1">
        <record id="rule_lhi_fleet_trip_company" model="ir.rule">
            <field name="name">Trip: Multi-Company</field>
            <field name="model_id" ref="model_lhi_fleet_trip"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="groups" eval="[(4, ref('lhi_security.group_lhi_fleet_viewer'))]"/>
        </record>
        <record id="rule_lhi_fleet_incident_company" model="ir.rule">
            <field name="name">Incident: Multi-Company</field>
            <field name="model_id" ref="model_lhi_fleet_incident"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="groups" eval="[(4, ref('lhi_security.group_lhi_fleet_viewer'))]"/>
        </record>
    </data>
</odoo>
