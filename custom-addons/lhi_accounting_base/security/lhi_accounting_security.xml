<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- New group for Sandbox Accounting testers to differentiate them from standard Billing -->
        <record id="privilege_lhi_accounting_sandbox" model="res.groups.privilege">
            <field name="name">LHI Accounting Sandbox</field>
            <field name="category_id" ref="base.module_category_accounting_accounting"/>
            <field name="sequence">90</field>
        </record>

        <record id="group_lhi_accounting_sandbox" model="res.groups">
            <field name="name">LHI Accounting Sandbox Tester</field>
            <field name="privilege_id" ref="privilege_lhi_accounting_sandbox"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
            <field name="comment">Members of this group can access accounting menus for testing, but they are still blocked by the server-side feature gate if it is disabled.</field>
        </record>
    </data>
</odoo>
