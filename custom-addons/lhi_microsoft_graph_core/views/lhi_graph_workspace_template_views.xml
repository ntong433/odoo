<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_graph_workspace_template_list" model="ir.ui.view">
        <field name="name">lhi.graph.workspace.template.list</field>
        <field name="model">lhi.graph.workspace.template</field>
        <field name="arch" type="xml">
            <list string="SharePoint Workspace Templates">
                <field name="name"/>
                <field name="code"/>
                <field name="library_code"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_lhi_graph_workspace_template_form" model="ir.ui.view">
        <field name="name">lhi.graph.workspace.template.form</field>
        <field name="model">lhi.graph.workspace.template</field>
        <field name="arch" type="xml">
            <form string="SharePoint Workspace Template">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="code"/>
                        <field name="library_code"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="relative_path"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lhi_graph_workspace_template" model="ir.actions.act_window">
        <field name="name">Workspace Templates</field>
        <field name="res_model">lhi.graph.workspace.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

