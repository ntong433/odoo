<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_asset_form" model="ir.ui.view">
        <field name="name">lhi.asset.form</field>
        <field name="model">lhi.asset</field>
        <field name="arch" type="xml">
            <form string="Asset">
                <header>
                    <button name="action_activate" string="Activate" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,maintenance,disposed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                        <label for="asset_tag" class="oe_edit_only"/>
                        <h2><field name="asset_tag" readonly="1"/></h2>
                    </div>
                    <group>
                        <group string="Basic Information">
                            <field name="category_id"/>
                            <field name="serial_number"/>
                            <field name="condition"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Custody &amp; Location">
                            <field name="custodian_id"/>
                            <field name="location_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Funding &amp; Ownership">
                            <group>
                                <field name="donor_id"/>
                                <field name="grant_id"/>
                                <field name="project_id"/>
                                <field name="purchase_order_id"/>
                                <field name="acquisition_date"/>
                                <field name="warranty_expiry"/>
                            </group>
                            <group string="Restrictions">
                                <field name="ownership_restriction" nolabel="1"/>
                            </group>
                        </page>
                        <page string="Transfer History">
                            <field name="transfer_ids" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_lhi_asset_tree" model="ir.ui.view">
        <field name="name">lhi.asset.tree</field>
        <field name="model">lhi.asset</field>
        <field name="arch" type="xml">
            <list string="Assets" decoration-muted="state == 'disposed'">
                <field name="asset_tag"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="custodian_id"/>
                <field name="location_id"/>
                <field name="condition"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
</odoo>
