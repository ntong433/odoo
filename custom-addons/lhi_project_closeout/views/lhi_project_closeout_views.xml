<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_project_closeout_form" model="ir.ui.view">
        <field name="name">lhi.project.closeout.form</field>
        <field name="model">lhi.project.closeout</field>
        <field name="arch" type="xml">
            <form string="Project Closeout">
                <header>
                    <button name="action_start" string="Start Closeout" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_review" string="Submit for Final Review" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_complete" string="Complete Closeout" type="object" class="btn-success" invisible="state != 'reviewed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,reviewed,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Basic Information">
                            <field name="project_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Financials &amp; Archives">
                            <field name="enterprise_financial_figures"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="archive_location"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Closeout Checklist">
                            <group>
                                <field name="programmatic_cleared"/>
                                <field name="procurement_cleared"/>
                                <field name="asset_cleared"/>
                                <field name="partner_cleared"/>
                                <field name="administrative_cleared"/>
                                <field name="financial_cleared"/>
                            </group>
                        </page>
                        <page string="Lessons Learned">
                            <field name="lessons_learned" placeholder="Record any important lessons learned from this project for future reference..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_lhi_project_closeout_tree" model="ir.ui.view">
        <field name="name">lhi.project.closeout.tree</field>
        <field name="model">lhi.project.closeout</field>
        <field name="arch" type="xml">
            <list string="Project Closeouts">
                <field name="name"/>
                <field name="project_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
</odoo>
