<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_request_programme_context" model="ir.ui.view">
        <field name="name">lhi.purchase.request.programme.context</field>
        <field name="model">lhi.purchase.request</field>
        <field name="inherit_id" ref="lhi_purchase_request.view_lhi_purchase_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='activity_id']" position="after">
                <field name="work_context"/>
                <field name="workplan_activity_id" invisible="work_context != 'project_linked'"/>
                <field name="memo_id" invisible="work_context != 'project_linked'"/>
                <field name="project_budget_line_id" invisible="work_context != 'project_linked'"/>
                <field name="enterprise_payment_reference" groups="lhi_programme_management.group_lhi_programmes_finance_reviewer"/>
            </xpath>
        </field>
    </record>
</odoo>
