<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_asset_import_wizard_form" model="ir.ui.view">
        <field name="name">lhi.asset.import.wizard.form</field>
        <field name="model">lhi.asset.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Legacy Asset Register">
                <group>
                    <field name="upload" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="default_state_id"/>
                </group>
                <div class="alert alert-info" role="alert">
                    CSV and XLSX are accepted. The legacy header
                    <strong>Purchase Vaue</strong> is supported. The source file is
                    uploaded and verified in SharePoint before preview rows are created.
                </div>
                <footer>
                    <button name="action_preview" string="Preserve and Preview"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_lhi_asset_import_batch_list" model="ir.ui.view">
        <field name="name">lhi.asset.import.batch.list</field>
        <field name="model">lhi.asset.import.batch</field>
        <field name="arch" type="xml">
            <list create="false" delete="false">
                <field name="name"/>
                <field name="source_filename"/>
                <field name="create_uid"/>
                <field name="create_date"/>
                <field name="imported_row_count"/>
                <field name="rejected_row_count"/>
                <field name="duplicate_count"/>
                <field name="total_imported_value"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_lhi_asset_import_batch_form" model="ir.ui.view">
        <field name="name">lhi.asset.import.batch.form</field>
        <field name="model">lhi.asset.import.batch</field>
        <field name="arch" type="xml">
            <form string="Asset Import Batch" create="false" delete="false">
                <header>
                    <button name="action_validate" string="Validate Preview"
                            type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_return_to_draft" string="Correct Rows"
                            type="object" invisible="state != 'validated'"/>
                    <button name="action_import" string="Import Valid Rows"
                            type="object" class="btn-success" invisible="state != 'validated'"/>
                    <button name="action_download_error_report" string="Download Error Report"
                            type="object" invisible="rejected_row_count == 0"/>
                    <button name="action_rollback" string="Roll Back Imported Assets"
                            type="object" class="btn-danger"
                            groups="lhi_security.group_lhi_asset_manager"
                            invisible="state not in ('imported', 'partial')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,validated,partial,imported,rolled_back"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="Preserved Source">
                            <field name="source_filename" readonly="1"/>
                            <field name="source_storage_state" readonly="1" widget="badge"/>
                            <field name="source_sharepoint_item_id" readonly="1"/>
                            <field name="source_checksum" readonly="1"/>
                            <button name="action_download_source" string="Open Source from SharePoint"
                                    type="object" class="btn-link"/>
                            <field name="error_report_checksum" readonly="1"/>
                        </group>
                        <group string="Defaults and Reconciliation">
                            <field name="default_state_id" readonly="state != 'draft'"/>
                            <field name="imported_row_count" readonly="1"/>
                            <field name="rejected_row_count" readonly="1"/>
                            <field name="duplicate_count" readonly="1"/>
                            <field name="total_imported_value" readonly="1"/>
                            <field name="currency_id" readonly="1"/>
                            <field name="imported_by_id" readonly="1"/>
                            <field name="imported_at" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids" nolabel="1" readonly="state != 'draft'">
                        <list editable="bottom" create="false" delete="false"
                              decoration-danger="validation_state == 'error'"
                              decoration-success="validation_state in ('valid', 'imported')">
                            <field name="row_number" readonly="1"/>
                            <field name="asset_name"/>
                            <field name="asset_tag"/>
                            <field name="serial_number"/>
                            <field name="acquisition_type_text"/>
                            <field name="condition_text"/>
                            <field name="acquisition_date_text"/>
                            <field name="acquisition_source_text"/>
                            <field name="project_abbreviation"/>
                            <field name="asset_value_text"/>
                            <field name="category_text"/>
                            <field name="state_text"/>
                            <field name="is_duplicate" readonly="1"/>
                            <field name="validation_state" readonly="1" widget="badge"/>
                            <field name="error_message" readonly="1"/>
                            <field name="asset_id" readonly="1"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_lhi_asset_import_wizard" model="ir.actions.act_window">
        <field name="name">Import Legacy Asset Register</field>
        <field name="res_model">lhi.asset.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_lhi_asset_import_batch" model="ir.actions.act_window">
        <field name="name">Asset Import Batches</field>
        <field name="res_model">lhi.asset.import.batch</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
