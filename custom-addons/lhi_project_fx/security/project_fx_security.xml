<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rule_lhi_award_amendment_company"
            model="ir.rule">

        <field name="name">
            Award Amendments: company isolation
        </field>

        <field name="model_id"
               ref="model_lhi_award_amendment"/>

        <field name="domain_force">
            [('company_id', 'in', company_ids)]
        </field>

        <field name="groups"
               eval="[(4, ref('base.group_user'))]"/>

    </record>


    <record id="rule_lhi_project_fx_company"
            model="ir.rule">

        <field name="name">
            Project FX Rates: company isolation
        </field>

        <field name="model_id"
               ref="model_lhi_project_fx_rate"/>

        <field name="domain_force">
            [('company_id', 'in', company_ids)]
        </field>

        <field name="groups"
               eval="[(4, ref('base.group_user'))]"/>

    </record>

</odoo>
