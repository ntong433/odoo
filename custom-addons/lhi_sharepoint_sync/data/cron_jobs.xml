<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_sharepoint_renew_subs" model="ir.cron">
            <field name="name">SharePoint: Renew Graph Subscriptions</field>
            <field name="model_id" ref="model_lhi_sharepoint_subscription"/>
            <field name="state">code</field>
            <field name="code">model.renew_subscriptions()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        
        <record id="ir_cron_sharepoint_delta_sync" model="ir.cron">
            <field name="name">SharePoint: Delta Synchronization</field>
            <field name="model_id" ref="model_lhi_sharepoint_delta"/>
            <field name="state">code</field>
            <field name="code">model.run_delta_sync()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
