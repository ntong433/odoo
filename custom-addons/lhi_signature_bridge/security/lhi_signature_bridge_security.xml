<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_lhi_signature_administration" model="ir.module.category">
        <field name="name">LHI Signature Administration</field>
        <field name="sequence">95</field>
    </record>

    <record id="privilege_lhi_signature_administration" model="res.groups.privilege">
        <field name="name">Signature Administration</field>
        <field name="category_id" ref="module_category_lhi_signature_administration"/>
        <field name="sequence">80</field>
        <field name="placeholder">No Access</field>
    </record>

    <record id="group_lhi_signature_preparation_officer" model="res.groups">
        <field name="name">Signature Preparation Officer</field>
        <field name="privilege_id" ref="privilege_lhi_signature_administration"/>
        <field name="implied_ids" eval="[(4, ref('lhi_security.group_lhi_employee'))]"/>
    </record>

    <record id="group_lhi_signature_admin" model="res.groups">
        <field name="name">Signature Administrator</field>
        <field name="privilege_id" ref="privilege_lhi_signature_administration"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_signature_preparation_officer'))]"/>
    </record>

    <record id="lhi_security.group_lhi_erp_admin" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_lhi_signature_admin'))]"/>
    </record>

    <record id="rule_lhi_opensign_request_admin" model="ir.rule">
        <field name="name">Signature administrators manage signature requests</field>
        <field name="model_id" ref="model_lhi_opensign_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_lhi_signature_admin'))]"/>
    </record>

    <record id="rule_lhi_opensign_recipient_admin" model="ir.rule">
        <field name="name">Signature administrators manage company recipients</field>
        <field name="model_id" ref="model_lhi_opensign_recipient"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_lhi_signature_admin'))]"/>
    </record>

    <record id="rule_lhi_opensign_configuration_company" model="ir.rule">
        <field name="name">Signature configuration company isolation</field>
        <field name="model_id" ref="model_lhi_opensign_configuration"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_lhi_signature_admin'))]"/>
    </record>

    <record id="rule_lhi_opensign_webhook_company" model="ir.rule">
        <field name="name">Signature webhook company isolation</field>
        <field name="model_id" ref="model_lhi_opensign_webhook_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_lhi_signature_admin'))]"/>
    </record>
</odoo>
