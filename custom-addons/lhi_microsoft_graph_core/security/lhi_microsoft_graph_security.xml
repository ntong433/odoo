<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_lhi_graph_connection_company" model="ir.rule">
            <field name="name">Microsoft Graph Connection: Multi-Company</field>
            <field name="model_id" ref="model_lhi_graph_connection"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('lhi_security.group_lhi_erp_admin')), (4, ref('lhi_security.group_lhi_integration_service'))]"/>
        </record>

        <record id="rule_lhi_graph_library_company" model="ir.rule">
            <field name="name">Microsoft Graph Library: Multi-Company</field>
            <field name="model_id" ref="model_lhi_graph_library"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('lhi_security.group_lhi_erp_admin')), (4, ref('lhi_security.group_lhi_integration_service'))]"/>
        </record>

        <record id="rule_lhi_graph_diagnostic_company" model="ir.rule">
            <field name="name">Microsoft Graph Diagnostic: Multi-Company</field>
            <field name="model_id" ref="model_lhi_graph_diagnostic"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('lhi_security.group_lhi_erp_admin'))]"/>
        </record>

        <record id="rule_lhi_graph_request_log_company" model="ir.rule">
            <field name="name">Microsoft Graph Request Log: Multi-Company</field>
            <field name="model_id" ref="model_lhi_graph_request_log"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('lhi_security.group_lhi_erp_admin')), (4, ref('lhi_security.group_lhi_internal_auditor'))]"/>
        </record>
    </data>
</odoo>

