<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_quant_tree_lhi_inherit" model="ir.ui.view">
        <field name="name">stock.quant.tree.lhi.inherit</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_id']" position="after">
                <field name="lhi_project_id" optional="show"/>
                <field name="lhi_donor_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
