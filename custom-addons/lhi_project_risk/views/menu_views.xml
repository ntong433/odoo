<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_lhi_project_risk" model="ir.actions.act_window">
        <field name="name">Project Risks</field>
        <field name="res_model">lhi.project.risk</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="search_view_id" ref="view_lhi_project_risk_search"/>
