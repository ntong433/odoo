<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_lhi_programmes" model="ir.module.category">
        <field name="name">Programs and Grants</field>
        <field name="description">Donor-funded programme lifecycle access</field>
        <field name="sequence">105</field>
    </record>
    <!-- Retained only as an upgrade compatibility alias. The migration moves
         direct memberships to the canonical lhi_security Viewer. -->
    <record id="group_lhi_programmes_viewer" model="res.groups">
        <field name="name">Legacy Programs and Grants Viewer</field>
        <field name="privilege_id" eval="False"/>
        <field name="implied_ids" eval="[(4, ref('lhi_security.group_lhi_programme_viewer'))]"/>
    </record>
    <record id="group_lhi_programmes_user" model="res.groups"><field name="name">Programs and Grants User</field><field name="privilege_id" ref="lhi_security.res_groups_privilege_lhi_programmes"/><field name="implied_ids" eval="[(4, ref('lhi_security.group_lhi_programme_viewer'))]"/></record>
    <record id="group_lhi_programmes_officer" model="res.groups"><field name="name">Programs and Grants Officer</field><field name="privilege_id" ref="lhi_security.res_groups_privilege_lhi_programmes"/><field name="implied_ids" eval="[(4, ref('group_lhi_programmes_user')), (4, ref('lhi_security.group_lhi_project_officer'))]"/></record>
    <record id="group_lhi_programmes_manager" model="res.groups"><field name="name">Programs and Grants Manager</field><field name="privilege_id" ref="lhi_security.res_groups_privilege_lhi_programmes"/><field name="implied_ids" eval="[(4, ref('group_lhi_programmes_officer')), (4, ref('lhi_security.group_lhi_project_manager'))]"/></record>
    <record id="group_lhi_programmes_finance_reviewer" model="res.groups"><field name="name">Programs and Grants Finance Reviewer</field><field name="privilege_id" eval="False"/><field name="implied_ids" eval="[(4, ref('lhi_security.group_lhi_programme_viewer'))]"/></record>
    <record id="group_lhi_programmes_finance_manager" model="res.groups"><field name="name">Programs and Grants Finance Manager</field><field name="privilege_id" eval="False"/><field name="implied_ids" eval="[(4, ref('group_lhi_programmes_finance_reviewer'))]"/></record>
    <record id="group_lhi_programmes_director" model="res.groups"><field name="name">Programs and Grants Director Approver</field><field name="privilege_id" ref="lhi_security.res_groups_privilege_lhi_programmes"/><field name="implied_ids" eval="[(4, ref('group_lhi_programmes_manager')), (4, ref('lhi_security.group_lhi_programme_director'))]"/></record>
    <record id="group_lhi_programmes_admin" model="res.groups"><field name="name">Programs and Grants Administrator</field><field name="privilege_id" ref="lhi_security.res_groups_privilege_lhi_programmes"/><field name="implied_ids" eval="[(4, ref('group_lhi_programmes_director')), (4, ref('group_lhi_programmes_finance_manager'))]"/></record>

    <record id="lhi_security.group_lhi_erp_admin" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_lhi_programmes_admin'))]"/>
    </record>

    <record id="rule_lhi_project_budget_company" model="ir.rule"><field name="name">Project budgets: company isolation</field><field name="model_id" ref="model_lhi_project_budget"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('lhi_security.group_lhi_programme_viewer'))]"/></record>
    <record id="rule_lhi_project_budget_line_company" model="ir.rule"><field name="name">Project budget lines: company isolation</field><field name="model_id" ref="model_lhi_project_budget_line"/><field name="domain_force">[('budget_id.company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('lhi_security.group_lhi_programme_viewer'))]"/></record>
    <record id="rule_lhi_activity_allocation_company" model="ir.rule"><field name="name">Activity allocations: company isolation</field><field name="model_id" ref="model_lhi_activity_budget_allocation"/><field name="domain_force">[('budget_line_id.budget_id.company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('lhi_security.group_lhi_programme_viewer'))]"/></record>
    <record id="rule_lhi_activity_memo_company" model="ir.rule"><field name="name">Activity memos: company isolation</field><field name="model_id" ref="model_lhi_activity_memo"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('lhi_security.group_lhi_programme_viewer'))]"/></record>
    <record id="rule_lhi_execution_request_company" model="ir.rule"><field name="name">Execution requests: company isolation</field><field name="model_id" ref="model_lhi_execution_request"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('lhi_security.group_lhi_programme_viewer'))]"/></record>
    <record id="rule_lhi_payment_retirement_company" model="ir.rule"><field name="name">Payment retirements: company isolation</field><field name="model_id" ref="model_lhi_payment_retirement"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('lhi_security.group_lhi_programme_viewer'))]"/></record>
</odoo>
