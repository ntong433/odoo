<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_document_migration_job_tree" model="ir.ui.view">
        <field name="name">lhi.document.migration.job.tree</field>
        <field name="model">lhi.document.migration.job</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="is_dry_run"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="action_lhi_document_migration_job" model="ir.actions.act_window">
        <field name="name">Migration Jobs</field>
        <field name="res_model">lhi.document.migration.job</field>
        <field name="view_mode">tree,form</field>
    </record>
    
    <menuitem id="menu_lhi_document_migration" name="Migration Tasks" parent="lhi_sharepoint_sync.menu_lhi_sharepoint_root" action="action_lhi_document_migration_job" sequence="30"/>
</odoo>
