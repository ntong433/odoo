<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ==================== LHI OFFICE ==================== -->
    <record id="view_lhi_office_tree" model="ir.ui.view">
        <field name="name">lhi.office.tree</field>
        <field name="model">lhi.office</field>
        <field name="arch" type="xml">
            <list string="Offices" decoration-muted="not active">
                <field name="code"/>
                <field name="name"/>
                <field name="office_type"/>
                <field name="parent_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_lhi_office_form" model="ir.ui.view">
        <field name="name">lhi.office.form</field>
        <field name="model">lhi.office</field>
        <field name="arch" type="xml">
            <form string="Office / Field Location">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Maiduguri Field Office"/></h1>
                    </div>
                    <group>
                        <group string="Basic Information">
                            <field name="code"/>
                            <field name="office_type"/>
                            <field name="parent_id"/>
                        </group>
                        <group string="Controls &amp; Validity">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_lhi_office_search" model="ir.ui.view">
        <field name="name">lhi.office.search</field>
        <field name="model">lhi.office</field>
        <field name="arch" type="xml">
            <search string="Search Offices">
                <field name="name"/>
                <field name="code"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="active_now" string="Currently Active" domain="[('active', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="action_lhi_office" model="ir.actions.act_window">
        <field name="name">Offices / Locations</field>
        <field name="res_model">lhi.office</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_lhi_office_search"/>
    </record>

