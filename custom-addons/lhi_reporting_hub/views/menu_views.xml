<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_lhi_reporting_hub_root" name="Reporting Hub" sequence="50" web_icon="lhi_reporting_hub,static/description/icon.png"/>

    <record id="action_lhi_reporting_job" model="ir.actions.act_window">
        <field name="name">Data Sync Jobs</field>
        <field name="res_model">lhi.reporting.job</field>
        <field name="view_mode">list,form</field>
    </record>
    
    <record id="action_lhi_data_quality_check" model="ir.actions.act_window">
        <field name="name">Quality Checks</field>
        <field name="res_model">lhi.data.quality.check</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_lhi_reporting_hub_jobs" name="Sync Jobs" parent="menu_lhi_reporting_hub_root" action="action_lhi_reporting_job" sequence="10"/>
    <menuitem id="menu_lhi_reporting_hub_checks" name="Quality Checks" parent="menu_lhi_reporting_hub_root" action="action_lhi_data_quality_check" sequence="20"/>
</odoo>
