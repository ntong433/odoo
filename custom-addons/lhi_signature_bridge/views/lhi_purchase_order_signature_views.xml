<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_purchase_order_signature_inherit" model="ir.ui.view">
        <field name="name">lhi.purchase.order.signature.inherit</field>
        <field name="model">lhi.purchase.order</field>
        <field name="inherit_id" ref="lhi_purchase_order.view_lhi_purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_for_signature" string="Send for Signature (OpenSign)" type="object" class="oe_highlight" invisible="state != 'approved' or signature_status != 'none'"/>
                <button name="action_cancel_signature" string="Cancel Signature" type="object" invisible="signature_status not in ('sent')"/>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="signature_status" readonly="1"/>
                <field name="opensign_request_id" readonly="1" invisible="not opensign_request_id" groups="lhi_signature_bridge.group_lhi_signature_admin"/>
                <field name="is_locked" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
