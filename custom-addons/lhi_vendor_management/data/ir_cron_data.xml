<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_vendor_expiry_alerts" model="ir.cron">
            <field name="name">LHI Vendor Expiry Alerts</field>
            <field name="model_id" ref="model_lhi_vendor"/>
            <field name="state">code</field>
            <field name="code">model.check_expiry_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
