<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Likelihood -->
        <record id="likelihood_1" model="lhi.risk.likelihood">
            <field name="name">Rare</field>
            <field name="value">1</field>
            <field name="description">Highly unlikely to occur</field>
        </record>
        <record id="likelihood_2" model="lhi.risk.likelihood">
            <field name="name">Unlikely</field>
            <field name="value">2</field>
            <field name="description">Not expected to occur</field>
        </record>
        <record id="likelihood_3" model="lhi.risk.likelihood">
            <field name="name">Possible</field>
            <field name="value">3</field>
            <field name="description">Might occur at some time</field>
        </record>
        <record id="likelihood_4" model="lhi.risk.likelihood">
            <field name="name">Likely</field>
            <field name="value">4</field>
            <field name="description">Will probably occur</field>
        </record>
        <record id="likelihood_5" model="lhi.risk.likelihood">
            <field name="name">Almost Certain</field>
            <field name="value">5</field>
            <field name="description">Expected to occur</field>
        </record>

        <!-- Impact -->
        <record id="impact_1" model="lhi.risk.impact">
            <field name="name">Insignificant</field>
            <field name="value">1</field>
            <field name="description">No significant impact</field>
        </record>
        <record id="impact_2" model="lhi.risk.impact">
            <field name="name">Minor</field>
            <field name="value">2</field>
            <field name="description">Minor consequences</field>
        </record>
        <record id="impact_3" model="lhi.risk.impact">
            <field name="name">Moderate</field>
            <field name="value">3</field>
            <field name="description">Significant localized impact</field>
        </record>
        <record id="impact_4" model="lhi.risk.impact">
            <field name="name">Major</field>
            <field name="value">4</field>
            <field name="description">Severe impact to objectives</field>
        </record>
        <record id="impact_5" model="lhi.risk.impact">
            <field name="name">Severe</field>
            <field name="value">5</field>
            <field name="description">Catastrophic impact</field>
        </record>
    </data>
</odoo>
