<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-Company Rules for LHI Base Master Data -->
        <record id="rule_lhi_office_multi_company" model="ir.rule">
            <field name="name">LHI Office Multi-Company</field>
            <field name="model_id" ref="lhi_base.model_lhi_office"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_lhi_department_multi_company" model="ir.rule">
            <field name="name">LHI Department Multi-Company</field>
