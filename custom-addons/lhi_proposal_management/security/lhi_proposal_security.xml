<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-company record rule for proposal workspaces -->
        <record id="rule_lhi_proposal_workspace_company" model="ir.rule">
            <field name="name">Proposal Workspace: Multi-Company</field>
            <field name="model_id" ref="model_lhi_proposal_workspace"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
