<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_lhi_entra" model="ir.ui.view">
        <field name="name">hr.employee.form.lhi.entra</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']/group" position="inside">
                <group string="Identity &amp; Integration" name="lhi_integration">
                    <field name="lhi_entra_object_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
