<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_lhi_results_framework_company" model="ir.rule">
            <field name="name">Results Framework: Multi-Company</field>
            <field name="model_id" ref="model_lhi_results_framework"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="groups" eval="[(4, ref('lhi_security.group_lhi_meal_viewer'))]"/>
        </record>
        
        <record id="rule_lhi_results_element_company" model="ir.rule">
            <field name="name">Results Element: Multi-Company</field>
            <field name="model_id" ref="model_lhi_results_element"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="groups" eval="[(4, ref('lhi_security.group_lhi_meal_viewer'))]"/>
        </record>
        
        <record id="rule_lhi_indicator_company" model="ir.rule">
            <field name="name">Indicator: Multi-Company</field>
            <field name="model_id" ref="model_lhi_indicator"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="groups" eval="[(4, ref('lhi_security.group_lhi_meal_viewer'))]"/>
        </record>
    </data>
</odoo>
