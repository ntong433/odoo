<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_open_external_link" model="ir.actions.server">
        <field name="name">Open External Link</field>
        <field name="model_id" ref="model_lhi_unified_inbox"/>
        <field name="state">code</field>
        <field name="code">
            action = {
                'type': 'ir.actions.act_url',
                'url': record.action_url,
                'target': 'new',
            }
        </field>
    </record>

    <record id="view_lhi_unified_inbox_tree" model="ir.ui.view">
        <field name="name">lhi.unified.inbox.tree</field>
        <field name="model">lhi.unified.inbox</field>
        <field name="arch" type="xml">
            <list string="Unified Inbox"
                  decoration-info="status == 'pending'">
                <field name="name"/>
                <field name="source_system"/>
                <field name="description"/>
                <field name="status" widget="badge"/>
                <field name="create_date"/>
                <button
                    name="%(action_open_external_link)d"
                    type="action"
                    string="Open in External App"
                    icon="fa-external-link"
                    invisible="not action_url"
                />
            </list>
        </field>
    </record>
</odoo>
