            <field name="domain_force">['|', ('request_line_id.request_id.document_type', '!=', 'hub_stock_request'), '|', '|', ('request_line_id.request_id.creator_id', '=', user.id), ('request_line_id.request_id.lhi_hub_request_id.requesting_hub_id', 'in', user.lhi_hub_ids.ids), ('request_line_id.approver_ids', 'in', user.id)]</field>
        </record>

