<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_memo_integration_operation_list" model="ir.ui.view">
        <field name="name">lhi.memo.integration.operation.list</field>
        <field name="model">lhi.memo.integration.operation</field>
        <field name="arch" type="xml">
            <list string="Integration Operations" decoration-info="state == 'draft'" decoration-warning="state in ('validating', 'retryable_failure')" decoration-danger="state in ('reconciliation_required', 'permanent_failure')" decoration-success="state == 'completed'">
                <field name="name"/>
                <field name="memo_id"/>
                <field name="operation_type"/>
                <field name="state"/>
                <field name="current_step"/>
                <field name="retry_count"/>
                <field name="requested_by"/>
                <field name="started_at"/>
                <field name="completed_at"/>
                <field name="requires_reconciliation"/>
            </list>
        </field>
    </record>

    <record id="view_lhi_memo_integration_operation_form" model="ir.ui.view">
        <field name="name">lhi.memo.integration.operation.form</field>
        <field name="model">lhi.memo.integration.operation</field>
        <field name="arch" type="xml">
            <form string="Integration Operation">
                <header>
                    <button name="action_retry" string="Retry Operation" type="object" class="btn-primary" invisible="state not in ('retryable_failure', 'permanent_failure') or requires_reconciliation"/>
                    <button name="action_reconcile" string="Reconcile Integration" type="object" class="btn-warning" groups="lhi_security.group_lhi_erp_admin" invisible="not requires_reconciliation and state != 'reconciliation_required'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,validating,creating_provider_draft,completed,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Operation Context">
                            <field name="memo_id" readonly="1"/>
                            <field name="operation_type" readonly="1"/>
                            <field name="correlation_id" readonly="1"/>
                            <field name="idempotency_key" readonly="1"/>
                            <field name="requested_by" readonly="1"/>
                        </group>
                        <group string="Execution Status">
                            <field name="current_step" readonly="1"/>
                            <field name="retry_count" readonly="1"/>
                            <field name="started_at" readonly="1"/>
                            <field name="completed_at" readonly="1"/>
                            <field name="outcome_uncertain" readonly="1"/>
                            <field name="requires_reconciliation" readonly="1"/>
                        </group>
                    </group>
                    <group string="Diagnostics &amp; Failure Log" invisible="not failure_code and not safe_failure_message">
                        <field name="failure_code" readonly="1"/>
                        <field name="safe_failure_message" readonly="1"/>
                        <field name="technical_failure_reference" readonly="1" groups="lhi_security.group_lhi_erp_admin"/>
                    </group>
                    <group string="Route &amp; Document Hashes">
                        <field name="approval_route_snapshot_hash" readonly="1"/>
                        <field name="source_document_hash" readonly="1"/>
                        <field name="signature_route_hash" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lhi_memo_integration_operation" model="ir.actions.act_window">
        <field name="name">Memo Integration Operations</field>
        <field name="res_model">lhi.memo.integration.operation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No integration operations logged yet.
            </p>
            <p>
                Tracks saga steps, idempotency keys, and diagnostics for Memo prepare and sign operations.
            </p>
        </field>
    </record>

    <menuitem id="menu_memo_integration_operations"
              name="Integration Operations"
              parent="lhi_memo_management.menu_memo_configuration"
              action="action_lhi_memo_integration_operation"
              groups="lhi_security.group_lhi_erp_admin"
              sequence="90"/>
</odoo>
