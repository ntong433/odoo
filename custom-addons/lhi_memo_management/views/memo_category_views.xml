<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_memo_category_list" model="ir.ui.view">
        <field name="name">lhi.memo.category.list</field>
        <field name="model">lhi.memo.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="approval_matrix_id"/>
                <field name="requester_signature_required"/>
                <field name="final_signature_required"/>
                <field name="default_expiry_days"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_lhi_memo_category_form" model="ir.ui.view">
        <field name="name">lhi.memo.category.form</field>
        <field name="model">lhi.memo.category</field>
        <field name="arch" type="xml">
            <form string="Memo Category">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                            <field name="default_recipient_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="approval_matrix_id"/>
                            <field name="approval_threshold"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="requester_signature_required"/>
                            <field name="final_signature_required"/>
                            <field name="default_expiry_days"/>
                            <field name="starter_document_item_id"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        The Word starter controls corporate layout only. Signature fields are placed dynamically on each captured PDF in LHI Sign.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lhi_memo_category" model="ir.actions.act_window">
        <field name="name">Memo Categories</field>
        <field name="res_model">lhi.memo.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_lhi_memo_approval_matrix" model="ir.actions.act_window">
        <field name="name">Memo Approval Routes</field>
        <field name="res_model">lhi.approval.matrix</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('document_type', '=', 'memo')]</field>
        <field name="context">{'default_document_type': 'memo'}</field>
    </record>
</odoo>
