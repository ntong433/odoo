<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_lhi_entra_identity_sync" model="ir.cron">
            <field name="name">LHI Entra Identity Reconciliation</field>
            <field name="model_id" ref="model_lhi_entra_configuration"/>
            <field name="state">code</field>
            <field name="code">model.cron_run_synchronization()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="False"/>
        </record>

        <record id="ir_cron_lhi_entra_failure_retry" model="ir.cron">
            <field name="name">LHI Entra Failure Queue Retry</field>
            <field name="model_id" ref="model_lhi_entra_sync_run"/>
            <field name="state">code</field>
            <field name="code">model.cron_retry_failures()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
        </record>
    </data>
</odoo>

