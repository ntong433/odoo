<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Announcements Multi-company Rule (if multi-company is later enabled) -->
        <!-- Right now, just basic global rules for users. -->
        <record id="lhi_announcement_global_rule" model="ir.rule">
            <field name="name">LHI Announcement Global</field>
            <field name="model_id" ref="model_lhi_announcement"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Widgets are global configuration, accessible by all internal users -->
        <record id="lhi_dashboard_widget_global_rule" model="ir.rule">
            <field name="name">LHI Dashboard Widget Global</field>
            <field name="model_id" ref="model_lhi_dashboard_widget"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
