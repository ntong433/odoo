<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_lhi_sharepoint_reconciliation" model="ir.cron">
            <field name="name">LHI SharePoint: Reconcile Documents</field>
            <field name="model_id" ref="model_lhi_document_item"/>
            <field name="state">code</field>
            <field name="code">model.cron_reconcile_documents(batch_size=100)</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
        </record>
        <record id="ir_cron_lhi_sharepoint_expire_sessions" model="ir.cron">
            <field name="name">LHI SharePoint: Expire Upload Sessions</field>
            <field name="model_id" ref="model_lhi_document_item"/>
            <field name="state">code</field>
            <field name="code">model.cron_expire_upload_sessions(batch_size=100)</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>
        <record id="ir_cron_lhi_sharepoint_cleanup_spool" model="ir.cron">
            <field name="name">LHI SharePoint: Clean Orphan Processing Files</field>
            <field name="model_id" ref="model_lhi_document_item"/>
            <field name="state">code</field>
            <field name="code">model.cron_cleanup_orphan_spool(minimum_age_hours=24)</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
