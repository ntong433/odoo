<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_lhi_purchase_order_company" model="ir.rule">
            <field name="name">PO: Multi-Company</field>
            <field name="model_id" ref="model_lhi_purchase_order"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="groups" eval="[(4, ref('lhi_security.group_lhi_procurement_viewer'))]"/>
        </record>
        <record id="rule_lhi_receipt_company" model="ir.rule">
            <field name="name">Receipt: Multi-Company</field>
            <field name="model_id" ref="model_lhi_receipt"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="groups" eval="[(4, ref('lhi_security.group_lhi_procurement_viewer'))]"/>
        </record>
    </data>
</odoo>
