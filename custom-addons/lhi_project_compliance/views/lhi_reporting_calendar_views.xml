<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_reporting_calendar_form" model="ir.ui.view">
        <field name="name">lhi.reporting.calendar.form</field>
        <field name="model">lhi.reporting.calendar</field>
        <field name="arch" type="xml">
            <form string="Reporting Calendar">
                <header>
                    <button name="action_mark_in_progress" string="Mark In Progress" type="object" invisible="status != 'pending' and status != 'late'"/>
                    <button name="action_submit_review" string="Submit for Review" type="object" class="oe_highlight" invisible="status != 'draft'"/>
                    <button name="action_mark_submitted" string="Mark Submitted to Donor" type="object" class="btn-success" invisible="status != 'review'"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending,draft,review,submitted,accepted"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="award_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="report_type"/>
                            <field name="frequency"/>
                        </group>
                        <group>
                            <field name="due_date"/>
                            <field name="submission_date"/>
                            <field name="owner_id" widget="many2one_avatar_user"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Attachments">
                            <field name="attachment_ids" widget="lhi_sharepoint_many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_lhi_reporting_calendar_tree" model="ir.ui.view">
        <field name="name">lhi.reporting.calendar.tree</field>
        <field name="model">lhi.reporting.calendar</field>
        <field name="arch" type="xml">
            <list string="Reporting Calendar" decoration-danger="status == 'late'" decoration-success="status in ('submitted', 'accepted')">
                <field name="name"/>
                <field name="project_id"/>
                <field name="report_type"/>
                <field name="due_date"/>
                <field name="owner_id" widget="many2one_avatar_user"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>
</odoo>
