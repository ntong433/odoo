<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_graph_request_log_list" model="ir.ui.view">
        <field name="name">lhi.graph.request.log.list</field>
        <field name="model">lhi.graph.request.log</field>
        <field name="arch" type="xml">
            <list string="Microsoft Graph Request Logs"
                  create="0"
                  edit="0"
                  delete="0"
                  decoration-success="outcome == 'success'"
                  decoration-warning="outcome == 'retry'"
                  decoration-danger="outcome == 'failure'">
                <field name="create_date"/>
                <field name="connection_id"/>
                <field name="auth_context"/>
                <field name="method"/>
                <field name="resource_path"/>
                <field name="outcome"/>
                <field name="status_code"/>
                <field name="duration_ms"/>
                <field name="retry_count"/>
                <field name="graph_request_id" optional="hide"/>
                <field name="client_request_id" optional="hide"/>
                <field name="error_code" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_lhi_graph_request_log_form" model="ir.ui.view">
        <field name="name">lhi.graph.request.log.form</field>
        <field name="model">lhi.graph.request.log</field>
        <field name="arch" type="xml">
            <form string="Microsoft Graph Request Log" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="create_date"/>
                            <field name="connection_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="user_id"/>
                            <field name="auth_context"/>
                        </group>
                        <group>
                            <field name="method"/>
                            <field name="resource_path"/>
                            <field name="outcome"/>
                            <field name="status_code"/>
                            <field name="duration_ms"/>
                            <field name="retry_count"/>
                        </group>
                    </group>
                    <group>
                        <field name="client_request_id"/>
                        <field name="graph_request_id"/>
                        <field name="error_code"/>
                        <field name="safe_message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lhi_graph_request_log" model="ir.actions.act_window">
        <field name="name">Graph Request Logs</field>
        <field name="res_model">lhi.graph.request.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

