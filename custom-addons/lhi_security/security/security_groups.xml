    <!-- Base User and Manager Groups (Keep xml_ids for backward compatibility with tests) -->
    <record id="group_lhi_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_lhi_erp"/>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_lhi_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_lhi_erp"/>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_user'))]"/>
        <!-- Protected administrators receive Manager through ERP Administrator;
             avoid two direct selections in the same native privilege. -->
        <field name="user_ids" eval="[(3, ref('base.user_root')), (3, ref('base.user_admin'))]"/>
    </record>

