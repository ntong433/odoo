<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Core ACL already grants ir.module.module only to base.group_system.
         Mirror that server-side boundary on every Apps navigation entry/action. -->
    <record id="base.menu_apps" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>
    <record id="base.menu_module_tree" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>
    <record id="base.menu_third_party" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>
    <record id="base.menu_theme_store" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>
    <record id="base.open_module_tree" model="ir.actions.act_window">
        <field name="group_ids" eval="[(6, 0, [ref('base.group_system')])]"/>
    </record>
</odoo>
