<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_entra_sync_run_list" model="ir.ui.view">
        <field name="name">lhi.entra.sync.run.list</field>
        <field name="model">lhi.entra.sync.run</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'failed'" decoration-warning="state == 'partial'" decoration-success="state == 'applied'">
                <field name="name"/>
                <field name="source"/>
                <field name="state" widget="badge"/>
                <field name="started_at"/>
                <field name="finished_at"/>
                <field name="graph_user_count"/>
                <field name="planned_user_count"/>
                <field name="applied_user_count"/>
                <field name="blocked_count"/>
                <field name="conflict_count"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_lhi_entra_sync_run_form" model="ir.ui.view">
        <field name="name">lhi.entra.sync.run.form</field>
        <field name="model">lhi.entra.sync.run</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <header>
                    <button name="action_approve_dry_run" type="object" string="Approve Dry Run" class="oe_highlight" invisible="state != 'planned' or blocked_count != 0"/>
                    <button name="action_apply" type="object" string="Apply Approved Plan" class="btn-primary" invisible="state != 'planned' or blocked_count != 0"/>
                    <button name="action_rollback" type="object" string="Rollback" class="btn-danger" invisible="state not in ('applied', 'partial')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,planned,applied,partial,failed,rolled_back"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="configuration_id"/>
                            <field name="connection_id"/>
                            <field name="source"/>
                            <field name="apply_requested"/>
                            <field name="requested_by_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="run_uuid"/>
                            <field name="idempotency_key"/>
                            <field name="plan_hash"/>
                            <field name="configuration_fingerprint"/>
                            <field name="safe_error"/>
                        </group>
                    </group>
                    <group string="Result Counts">
                        <field name="graph_user_count"/>
                        <field name="planned_user_count"/>
                        <field name="applied_user_count"/>
                        <field name="blocked_count"/>
                        <field name="conflict_count"/>
                        <field name="missing_mapping_count"/>
                        <field name="missing_manager_count"/>
                    </group>
                    <notebook>
                        <page string="User Plans">
                            <field name="plan_ids">
                                <list>
                                    <field name="user_id"/>
                                    <field name="entra_upn"/>
                                    <field name="match_method"/>
                                    <field name="state" widget="badge"/>
                                    <field name="safe_error"/>
                                </list>
                            </field>
                        </page>
                        <page string="Dry-run Findings">
                            <field name="finding_ids">
                                <list decoration-danger="severity == 'error'" decoration-warning="severity == 'warning'">
                                    <field name="severity" widget="badge"/>
                                    <field name="category"/>
                                    <field name="user_id"/>
                                    <field name="entra_upn"/>
                                    <field name="mapping_id"/>
                                    <field name="message"/>
                                </list>
                            </field>
                        </page>
                        <page string="Rollback Snapshots" groups="lhi_security.group_lhi_erp_admin">
                            <field name="snapshot_ids">
                                <list>
                                    <field name="user_id"/>
                                    <field name="before_hash"/>
                                    <field name="after_hash"/>
                                    <field name="rolled_back"/>
                                    <field name="rolled_back_at"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_lhi_entra_sync_run" model="ir.actions.act_window">
        <field name="name">Entra Sync Diagnostics</field>
        <field name="res_model">lhi.entra.sync.run</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
