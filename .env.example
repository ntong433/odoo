# ================================================================
# LHI ERP — Public application configuration
# ================================================================

LHI_PUBLIC_URL=https://work.lhinigeria.org

# Primary Odoo Entra sign-in callback implemented by auth_oauth.
ENTRA_REDIRECT_URI=https://work.lhinigeria.org/auth_oauth/signin

# Separate delegated Microsoft Graph authorization-code/PKCE callback used by
# document preview and Microsoft 365 user-driven operations.
ENTRA_GRAPH_DELEGATED_REDIRECT_URI=https://work.lhinigeria.org/lhi/microsoft_graph/oauth/callback

# ================================================================
# Microsoft Entra application
# ================================================================

ENTRA_TENANT_ID=552a1d00-ce70-4fdb-940f-0ad131e4b9cb
ENTRA_CLIENT_ID=02b3748f-e84b-4bec-935a-21fab1498517

# Secret VALUE from:
# Entra → App registrations → LHI ERP → Certificates & secrets
# Never use the Secret ID. Set the value only in protected Coolify settings.
ENTRA_CLIENT_SECRET=__SET_IN_COOLIFY__

ENTRA_AUTHORITY=https://login.microsoftonline.com/552a1d00-ce70-4fdb-940f-0ad131e4b9cb
ENTRA_GRAPH_SCOPE=https://graph.microsoft.com/.default
ENTRA_TOKEN_ENDPOINT=https://login.microsoftonline.com/552a1d00-ce70-4fdb-940f-0ad131e4b9cb/oauth2/v2.0/token

# Primary login for ordinary users.
ENTRA_SSO_ENABLED=true

# Preserve controlled local administrator authentication.
LOCAL_ADMIN_LOGIN_ENABLED=true

# ================================================================
# SharePoint Online
# ================================================================

SHAREPOINT_HOSTNAME=lhisokoto.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/ERP
SHAREPOINT_SITE_ID=lhisokoto.sharepoint.com,a307baa8-0966-493a-8c93-147ab14d086d,88f486b7-3c86-436f-a0de-0968fbf2d420

SHAREPOINT_LIBRARY_NAME=Documents
SHAREPOINT_DRIVE_ID=b!qLoHo2YJOkmMkxR6sU0IbbeG9IiGPG9DoN4JaPvy1CAv6wvCWH9ZQIOHqh5ZXKtf

SHAREPOINT_ROOT_FOLDER=ERP
SHAREPOINT_ROOT_ITEM_ID=01QTWNMA2W4O2DS5DA5VBIK7ARAKQREBQT

SHAREPOINT_STORAGE_ENABLED=true

# Business files must not silently fall back to permanent local storage.
SHAREPOINT_ALLOW_LOCAL_FALLBACK=false

# Encrypted/persistent temporary processing area. This is not the Odoo
# filestore and must not be used as permanent business-document storage.
LHI_SHAREPOINT_SPOOL_DIR=/var/lib/odoo/lhi-sharepoint-spool

# ================================================================
# Microsoft Graph webhook and synchronization
# ================================================================

GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_WEBHOOK_URL=https://work.lhinigeria.org/lhi/graph/notifications

# Generate with: openssl rand -hex 32
# Set only in protected Coolify settings.
GRAPH_WEBHOOK_CLIENT_STATE=__SET_IN_COOLIFY__

GRAPH_SYNC_ENABLED=true
GRAPH_DELTA_SYNC_ENABLED=true
GRAPH_SUBSCRIPTION_RENEWAL_ENABLED=true

GRAPH_HTTP_TIMEOUT_SECONDS=60
GRAPH_MAX_RETRIES=5
GRAPH_RETRY_BASE_SECONDS=2

# ================================================================
# Entra identity synchronization
# ================================================================

ENTRA_IDENTITY_SYNC_ENABLED=true
ENTRA_MANAGER_SYNC_ENABLED=true
ENTRA_GROUP_SYNC_ENABLED=true

# Existing LHI RBAC remains authoritative.
ENTRA_CREATE_DUPLICATE_ODOO_GROUPS=false
ENTRA_PROTECTED_GROUPS_ENABLED=true

# Run in audit-only mode before enabling membership changes.
ENTRA_GROUP_SYNC_DRY_RUN=false

# Protected maintenance login network boundary. Use approved VPN, Cloudflare
# Access egress, or administrator-only source networks. Comma-separated CIDRs.
LHI_ENTRA_MAINTENANCE_ALLOWED_CIDRS=

# Set true only when Coolify's trusted reverse proxy overwrites
# X-Forwarded-For.
LHI_ENTRA_TRUST_PROXY_HEADERS=false

# ================================================================
# Document behaviour
# ================================================================

DOCUMENT_PREVIEW_ENABLED=true
DOCUMENT_MICROSOFT_EDIT_ENABLED=true
DOCUMENT_EDIT_NEW_TAB=true

DOCUMENT_MIGRATION_ENABLED=false
DOCUMENT_LOCAL_PURGE_ENABLED=false

# ================================================================
# Odoo and PostgreSQL container configuration
# ================================================================

ODOO_MASTER_PASSWORD=__SET_IN_COOLIFY__
POSTGRES_DB=lhi_erp
POSTGRES_USER=odoo
POSTGRES_PASSWORD=__SET_IN_COOLIFY__
ODOO_WORKERS=0
ODOO_MAX_CRON_THREADS=2
ODOO_LOG_LEVEL=info
# Initialize Odoo only when the configured PostgreSQL database has no Odoo schema.
ODOO_INITIALIZE_DATABASE_IF_EMPTY=true
LHI_ENVIRONMENT=production

# ================================================================
# Do not add certificate variables
# ================================================================

# Do not define:
# ENTRA_CERTIFICATE_PATH
# ENTRA_CERTIFICATE_THUMBPRINT
# ENTRA_PRIVATE_KEY
# ENTRA_PFX_PATH
# ENTRA_PFX_PASSWORD
