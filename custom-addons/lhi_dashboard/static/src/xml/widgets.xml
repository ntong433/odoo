<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Announcements Widget -->
    <t t-name="lhi_dashboard.AnnouncementsWidget" owl="1">
        <div class="lhi-card mb-4">
            <div class="lhi-card__header px-4 py-3">
                <h3 class="lhi-card__title m-0 fw-bold">Announcements</h3>
            </div>
            <div class="lhi-card__body p-0">
                <div t-if="state.loading" class="p-4 text-center text-muted">
                    <i class="fa fa-circle-o-notch fa-spin fa-2x"></i>
                </div>
                <div t-elif="state.announcements.length === 0" class="p-4 text-center text-muted">
                    <i class="fa fa-bullhorn fa-2x mb-3 opacity-25"></i>
                    <p class="mb-0">No active announcements.</p>
                </div>
                <div t-else="" class="list-group list-group-flush">
                    <t t-foreach="state.announcements" t-as="ann" t-key="ann.id">
                        <div class="list-group-item p-4 border-bottom-0">
                            <div class="d-flex w-100 justify-content-between align-items-center mb-2">
                                <h5 class="mb-0 fw-bold text-dark" t-esc="ann.title"/>
                                <small class="text-muted fw-medium" t-esc="ann.date"/>
                            </div>
                            <span t-attf-class="badge rounded-pill text-bg-{{ann.type === 'danger' ? 'danger' : (ann.type === 'warning' ? 'warning' : 'primary')}} mb-2 px-2 py-1">
                                <t t-if="ann.type === 'danger'">Urgent</t>
                                <t t-elif="ann.type === 'warning'">Warning</t>
                                <t t-elif="ann.type === 'success'">Success</t>
                                <t t-else="">Info</t>
                            </span>
                            <div class="mt-2 text-muted" style="font-size: 14px;" t-out="ann.content"/>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>

    <!-- Accessible Modules Widget -->
    <t t-name="lhi_dashboard.AccessibleModulesWidget" owl="1">
        <section t-if="state.apps.length" class="lhi-my-apps" aria-labelledby="lhi-my-apps-title">
            <h2 id="lhi-my-apps-title" class="lhi-my-apps__title">My Apps</h2>
            <div class="lhi-app-grid">
                <t t-foreach="state.apps" t-as="app" t-key="app._lhiSidebarKey || app.xmlid || app.key || app.menu_id">
                    <button type="button" class="lhi-app-tile text-center d-flex flex-column align-items-center justify-content-center" t-on-click="() => this.onAppClick(app)">
                        <span class="lhi-app-icon-bg d-flex align-items-center justify-content-center" aria-hidden="true">
                            <img t-att-src="app.icon_url" class="lhi-app-icon-img" alt=""/>
                        </span>
                        <span class="lhi-app-title" t-esc="app.name"/>
                    </button>
                </t>
            </div>
        </section>
    </t>

    <!-- My Approvals Widget -->
    <t t-name="lhi_dashboard.MyApprovalsWidget" owl="1">
        <div t-attf-class="lhi-card lhi-kpi-secondary mb-4 overflow-hidden #{state.available ? 'lhi-card--interactive' : ''}" t-on-click="openApprovals">
            <div class="lhi-card__body p-4 position-relative">
                <div class="d-flex justify-content-between align-items-center position-relative z-index-1">
                    <div>
                        <div class="fw-medium opacity-75 text-uppercase tracking-wide" style="font-size: 11px; letter-spacing: 0.5px;">Pending Approvals</div>
                        <div class="fw-bold mt-1" style="font-size: 2.25rem;" t-if="!state.loading">
                            <t t-if="state.available"><t t-esc="state.count"/></t>
                            <t t-else=""><span style="font-size: 1.25rem;">N/A</span></t>
                        </div>
                        <div class="lhi-skeleton lhi-skeleton--text mt-2 bg-white opacity-25" t-else="" style="width: 45px; height: 35px;"></div>
                    </div>
                    <div class="opacity-20">
                        <i class="fa fa-check-circle" style="font-size: 3.5rem;"></i>
                    </div>
                </div>
                <!-- Decorative background -->
                <div class="lhi-kpi-bg-overlay"></div>
            </div>
            <div class="lhi-kpi-footer px-4 py-2 fw-bold text-center" t-att-style="state.available ? 'cursor: pointer;' : 'cursor: not-allowed; opacity: 0.5;'">
                Review Approvals <i class="fa fa-arrow-right ms-1"></i>
            </div>
        </div>
    </t>

    <!-- My Tasks Widget -->
    <t t-name="lhi_dashboard.MyTasksWidget" owl="1">
        <div class="lhi-card lhi-kpi-primary mb-4 overflow-hidden lhi-card--interactive" t-on-click="openTasks">
            <div class="lhi-card__body p-4 position-relative">
                <div class="d-flex justify-content-between align-items-center position-relative z-index-1">
                    <div>
                        <div class="fw-medium opacity-75 text-uppercase tracking-wide" style="font-size: 11px; letter-spacing: 0.5px;">My Activities</div>
                        <div class="fw-bold mt-1" style="font-size: 2.25rem;" t-if="!state.loading"><t t-esc="state.count"/></div>
                        <div class="lhi-skeleton lhi-skeleton--text mt-2 bg-white opacity-25" t-else="" style="width: 45px; height: 35px;"></div>
                    </div>
                    <div class="opacity-20">
                        <i class="fa fa-tasks" style="font-size: 3.5rem;"></i>
                    </div>
                </div>
                <div class="lhi-kpi-bg-overlay"></div>
            </div>
            <div class="lhi-kpi-footer px-4 py-2 fw-bold text-center">
                View Tasks <i class="fa fa-arrow-right ms-1"></i>
            </div>
        </div>
    </t>

    <!-- Notifications Widget -->
    <t t-name="lhi_dashboard.NotificationsWidget" owl="1">
        <div class="lhi-card lhi-kpi-accent mb-4 overflow-hidden lhi-card--interactive" t-on-click="openInbox">
            <div class="lhi-card__body p-4 position-relative">
                <div class="d-flex justify-content-between align-items-center position-relative z-index-1">
                    <div>
                        <div class="fw-medium opacity-75 text-uppercase tracking-wide" style="font-size: 11px; letter-spacing: 0.5px;">Messages &amp; Alerts</div>
                        <div class="fw-bold mt-1" style="font-size: 2.25rem;">Inbox</div>
                    </div>
                    <div class="opacity-20">
                        <i class="fa fa-envelope" style="font-size: 3.5rem;"></i>
                    </div>
                </div>
                <div class="lhi-kpi-bg-overlay"></div>
            </div>
            <div class="lhi-kpi-footer px-4 py-2 fw-bold text-center">
                Open Discuss <i class="fa fa-arrow-right ms-1"></i>
            </div>
        </div>
    </t>

    <!-- Quick Actions Widget -->
    <t t-name="lhi_dashboard.QuickActionsWidget" owl="1">
        <div class="lhi-card mb-4" t-if="!state.loading and state.actions.length > 0">
            <div class="lhi-card__header px-4 py-3">
                <h3 class="lhi-card__title m-0 fw-bold">Quick Actions</h3>
            </div>
            <div class="lhi-card__body p-0 overflow-hidden">
                <div class="list-group list-group-flush">
                    <t t-foreach="state.actions" t-as="action" t-key="action.id">
                        <button class="list-group-item list-group-item-action p-3 d-flex align-items-center gap-3 border-0 border-bottom text-start" t-on-click="() => this.executeAction(action)">
                            <div class="lhi-app-icon-bg d-flex align-items-center justify-content-center rounded-circle" style="width: 36px; height: 36px; margin: 0;">
                                <i t-attf-class="fa #{action.icon}"></i>
                            </div>
                            <div>
                                <span class="fw-bold text-dark d-block" style="font-size: 13px;"><t t-esc="action.name"/></span>
                                <span class="text-muted small" style="font-size: 11px;"><t t-esc="action.description"/></span>
                            </div>
                        </button>
                    </t>
                </div>
            </div>
        </div>
    </t>

</templates>
