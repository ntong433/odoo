<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="lhi_powerbi.ReportViewer" owl="1">
        <div class="o_lhi_powerbi_viewer h-100 d-flex flex-column">
            <div class="p-3 bg-white border-bottom shadow-sm">
                <h3 class="mb-0"><i class="fa fa-bar-chart me-2 text-primary"/> <t t-esc="props.action.name"/></h3>
            </div>
            
            <div class="flex-grow-1 p-3 bg-light">
                <div t-if="state.isLoading" class="d-flex justify-content-center align-items-center h-100">
                    <div class="text-center">
                        <i class="fa fa-circle-o-notch fa-spin fa-3x text-primary mb-3"/>
                        <h4>Authenticating with Microsoft Entra...</h4>
                        <p class="text-muted">Loading Power BI Embedded Token</p>
                    </div>
                </div>
                <div t-else="" class="h-100 bg-white border rounded shadow-sm overflow-hidden">
                    <!-- In a real environment, this iframe would use powerbi.js to embed securely with the token -->
                    <!-- For the sprint simulation, we provide a placeholder frame -->
                    <iframe 
                        t-att-src="state.reportParams.embed_url" 
                        frameborder="0" 
                        allowFullScreen="true" 
                        class="w-100 h-100"
                        title="Power BI Report">
                    </iframe>
                </div>
            </div>
        </div>
    </t>
</templates>
