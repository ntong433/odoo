<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_lhi_memo_document_template_form" model="ir.ui.view">
        <field name="name">lhi.memo.document.template.form</field>
        <field name="model">lhi.memo.document.template</field>
        <field name="arch" type="xml">
            <form string="Memo Document Template">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. LHI Internal Memo Template"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Template Information">
                            <field name="code"/>
                            <field name="version"/>
                            <field name="sharepoint_version"/>
                            <field name="is_default"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="SharePoint Identifiers">
                            <field name="sharepoint_drive_id"/>
                            <field name="sharepoint_item_id"/>
                            <field name="sharepoint_parent_folder_id"/>
                            <field name="sharepoint_site_id"/>
                            <field name="sharepoint_file_name"/>
                        </group>
                    </group>
                    <group string="SharePoint Metadata">
                        <group>
                            <field name="sharepoint_etag"/>
                            <field name="sharepoint_ctag"/>
                        </group>
                        <group>
                            <field name="sharepoint_file_size"/>
                            <field name="sharepoint_last_modified"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Web URL &amp; Notes">
                            <group>
                                <field name="sharepoint_web_url" widget="url"/>
                            </group>
                            <field name="notes" placeholder="Additional administrative notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree / List View -->
    <record id="view_lhi_memo_document_template_tree" model="ir.ui.view">
        <field name="name">lhi.memo.document.template.tree</field>
        <field name="model">lhi.memo.document.template</field>
        <field name="arch" type="xml">
            <list string="Memo Document Templates">
                <field name="name"/>
                <field name="code"/>
                <field name="version"/>
                <field name="sharepoint_version"/>
                <field name="is_default"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_lhi_memo_document_template_search" model="ir.ui.view">
        <field name="name">lhi.memo.document.template.search</field>
        <field name="model">lhi.memo.document.template</field>
        <field name="arch" type="xml">
            <search string="Search Memo Document Templates">
                <field name="name"/>
                <field name="code"/>
                <field name="sharepoint_item_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Default" name="default" domain="[('is_default', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Company" name="group_company" domain="[]" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_lhi_memo_document_template" model="ir.actions.act_window">
        <field name="name">Memo Document Templates</field>
        <field name="res_model">lhi.memo.document.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_lhi_memo_document_template_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Memo Document Template configuration!
            </p>
            <p>
                Configure official SharePoint-hosted Word templates for LHI ERP memo generation.
            </p>
        </field>
    </record>
</odoo>
