<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_hub_product_template_form" model="ir.ui.view">
        <field name="name">product.template.form.lhi.hub</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="LHI HUB Controls" name="lhi_hub_controls">
                    <group>
                        <group string="Stock Governance">
                            <field name="lhi_hub_item_type"/>
                            <field name="lhi_controlled_item"/>
                            <field name="lhi_individually_identifiable"/>
                            <field name="lhi_leaseable"/>
                            <field name="lhi_asset_category_id"/>
                            <field name="lhi_low_stock_threshold"/>
                            <field name="lhi_lease_daily_rate"/>
                            <field name="lhi_temperature_requirement"/>
                        </group>
                        <group string="Operational Valuation">
                            <field name="lhi_value_source"/>
                            <field name="lhi_purchase_value" invisible="lhi_value_source != 'purchase_price'"/>
                            <field name="lhi_donor_declared_value" invisible="lhi_value_source != 'donor_declared'"/>
                            <field name="lhi_partner_declared_value" invisible="lhi_value_source != 'partner_declared'"/>
                            <field name="lhi_replacement_value" invisible="lhi_value_source != 'replacement'"/>
                            <field name="lhi_legacy_value" invisible="lhi_value_source != 'legacy'"/>
                            <field name="lhi_manual_value" invisible="lhi_value_source != 'manual'"/>
                            <field name="lhi_operational_unit_value" readonly="1"/>
                            <field name="lhi_value_currency_id"/>
                            <field name="lhi_value_date"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_lhi_hub_lot_form" model="ir.ui.view">
        <field name="name">stock.lot.form.lhi.hub</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main_group']" position="after">
                <group string="LHI HUB Traceability">
                    <group>
                        <field name="lhi_manufacturing_date"/>
                        <field name="expiration_date"/>
                        <field name="removal_date"/>
                        <field name="lhi_temperature_requirement"/>
                    </group>
                    <group>
                        <field name="lhi_donor_id"/>
                        <field name="lhi_hub_id" readonly="1"/>
                        <field name="lhi_consignment_id"/>
                        <field name="lhi_project_id"/>
                        <field name="lhi_award_id"/>
                        <field name="lhi_quarantine_status"/>
                        <field name="lhi_quarantine_reason"
                               invisible="lhi_quarantine_status == 'released'"/>
                        <field name="lhi_asset_id" readonly="1"/>
                    </group>
                </group>
                <button name="action_promote_to_asset_register" type="object"
                        string="Promote Serial to Asset Register"
                        groups="lhi_security.group_lhi_asset_officer"
                        invisible="lhi_asset_id"/>
            </xpath>
        </field>
    </record>

    <record id="action_lhi_hub_products" model="ir.actions.act_window">
        <field name="name">HUB Item Catalogue</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('lhi_hub_item_type', '!=', False)]</field>
        <field name="context">{'default_is_storable': True}</field>
    </record>

    <record id="action_lhi_hub_lots" model="ir.actions.act_window">
        <field name="name">Lots, Batches and Serials</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
