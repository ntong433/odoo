        <!-- The reusable approval engine remains broadly reusable for non-HUB
             documents, while HUB routes are limited to creator, assigned HUB
             staff, or users frozen into the submitted route. -->
        <record id="rule_lhi_hub_approval_request_scope" model="ir.rule">
            <field name="name">Approval Request: Govern HUB Route Scope</field>
            <field name="model_id" ref="lhi_approval_matrix.model_lhi_approval_request"/>
            <field name="groups" eval="[(4, ref('lhi_security.group_lhi_employee'))]"/>
            <field name="domain_force">['|', ('document_type', '!=', 'hub_stock_request'), '|', '|', ('creator_id', '=', user.id), ('lhi_hub_request_id.requesting_hub_id', 'in', user.lhi_hub_ids.ids), ('line_ids.approver_ids', 'in', user.id)]</field>
        </record>
        <record id="rule_lhi_hub_approval_line_scope" model="ir.rule">
            <field name="name">Approval Line: Govern HUB Route Scope</field>
            <field name="model_id" ref="lhi_approval_matrix.model_lhi_approval_request_line"/>
            <field name="groups" eval="[(4, ref('lhi_security.group_lhi_employee'))]"/>
            <field name="domain_force">['|', ('request_id.document_type', '!=', 'hub_stock_request'), '|', '|', ('request_id.creator_id', '=', user.id), ('request_id.lhi_hub_request_id.requesting_hub_id', 'in', user.lhi_hub_ids.ids), ('approver_ids', 'in', user.id)]</field>
