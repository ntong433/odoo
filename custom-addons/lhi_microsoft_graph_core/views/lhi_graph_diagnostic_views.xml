<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_graph_diagnostic_list" model="ir.ui.view">
        <field name="name">lhi.graph.diagnostic.list</field>
        <field name="model">lhi.graph.diagnostic</field>
        <field name="arch" type="xml">
            <list string="Microsoft Graph Diagnostics"
                  create="0"
                  edit="0"
                  delete="0"
                  decoration-success="state == 'success'"
                  decoration-danger="state == 'failure'">
                <field name="connection_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="run_by_id"/>
                <field name="state"/>
                <field name="completed_at"/>
            </list>
        </field>
    </record>

    <record id="view_lhi_graph_diagnostic_form" model="ir.ui.view">
        <field name="name">lhi.graph.diagnostic.form</field>
        <field name="model">lhi.graph.diagnostic</field>
        <field name="arch" type="xml">
            <form string="Microsoft Graph Diagnostic" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <field name="connection_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="run_by_id"/>
                        <field name="state"/>
                        <field name="completed_at"/>
                    </group>
                    <group string="Safe Structured Results">
                        <field name="details" nolabel="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lhi_graph_diagnostic" model="ir.actions.act_window">
        <field name="name">Graph Diagnostics</field>
        <field name="res_model">lhi.graph.diagnostic</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

