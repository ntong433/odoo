<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_lhi_fleet_trip" model="ir.actions.act_window">
        <field name="name">Trip Requests</field>
        <field name="res_model">lhi.fleet.trip</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_lhi_fleet_incident" model="ir.actions.act_window">
        <field name="name">Incidents</field>
        <field name="res_model">lhi.fleet.incident</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Odoo 19 standard Fleet application submenu. -->
    <menuitem id="menu_lhi_fleet_trip" name="Trip Requests" parent="fleet.fleet_vehicles" action="action_lhi_fleet_trip" sequence="10"/>
    <menuitem id="menu_lhi_fleet_incident" name="Incidents" parent="fleet.fleet_vehicles" action="action_lhi_fleet_incident" sequence="15"/>
</odoo>
