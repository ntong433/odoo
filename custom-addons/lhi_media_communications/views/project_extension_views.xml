<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_project_form_inherit_media" model="ir.ui.view">
        <field name="name">lhi.project.form.inherit.media</field>
        <field name="model">lhi.project</field>
        <field name="inherit_id" ref="lhi_base.view_lhi_project_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_media_requests" type="object" class="oe_stat_button" icon="fa-envelope">
                        <field name="media_request_count" widget="statinfo" string="Media Requests"/>
                    </button>
                    <button name="action_view_media_activities" type="object" class="oe_stat_button" icon="fa-calendar">
                        <field name="media_activity_count" widget="statinfo" string="Media Activities"/>
                    </button>
                    <button name="action_view_media_success_stories" type="object" class="oe_stat_button" icon="fa-star">
                        <field name="media_success_story_count" widget="statinfo" string="Success Stories"/>
                    </button>
                    <button name="action_view_media_assets" type="object" class="oe_stat_button" icon="fa-image">
                        <field name="media_asset_count" widget="statinfo" string="Media Assets"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
