<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Server-rendered title and favicon branding in web.layout -->
    <template id="lhi_web_layout_branding" inherit_id="web.layout" name="LHI ERP Web Layout Branding" priority="10">
        <xpath expr="//title" position="replace">
            <title t-esc="title or 'LHI ERP'"/>
        </xpath>

        <xpath expr="//link[@rel='shortcut icon']" position="replace">
            <link
                rel="shortcut icon"
                type="image/png"
                href="/lhi_erp_branding/static/src/img/lhi_favicon.png?v=20260724"
            />
            <link
                rel="icon"
                type="image/png"
                sizes="32x32"
                href="/lhi_erp_branding/static/src/img/lhi_favicon.png?v=20260724"
            />
        </xpath>
    </template>

    <!-- Apple touch icon replacement in web.webclient_bootstrap -->
    <template id="lhi_webclient_bootstrap_branding" inherit_id="web.webclient_bootstrap" name="LHI ERP Web Client Branding" priority="10">
        <xpath expr="//link[@rel='apple-touch-icon']" position="replace">
            <link
                rel="apple-touch-icon"
                href="/lhi_erp_branding/static/src/img/lhi_favicon.png?v=20260724"
            />
        </xpath>
    </template>

    <!-- Brand promotion message override -->
    <template id="lhi_brand_promotion_message" inherit_id="web.brand_promotion_message" name="LHI ERP Brand Promotion Message" priority="10">
        <xpath expr="//t[@t-set='odoo_logo']" position="replace">
            <t t-set="odoo_logo">
                <span class="fw-bold text-primary">LHI ERP</span>
            </t>
        </xpath>
    </template>

    <!-- Offline page branding override -->
    <template id="lhi_webclient_offline_branding" inherit_id="web.webclient_offline" name="LHI ERP Offline Branding" priority="10">
        <xpath expr="//p" position="replace">
            <p>Check your network connection and come back here. LHI ERP will load as soon as you're back online.</p>
        </xpath>
    </template>
</odoo>
