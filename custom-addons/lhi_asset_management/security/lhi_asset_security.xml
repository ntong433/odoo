<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_lhi_asset_company" model="ir.rule">
            <field name="name">Asset: Multi-Company</field>
            <field name="model_id" ref="model_lhi_asset"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_lhi_asset_transfer_company" model="ir.rule">
            <field name="name">Asset Transfer: Multi-Company</field>
            <field name="model_id" ref="model_lhi_asset_transfer"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
