<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron job to process pending integrations and dead letter retries -->
        <record id="ir_cron_process_integration_jobs" model="ir.cron">
            <field name="name">LHI Integration: Process Jobs &amp; Retries</field>
            <field name="model_id" ref="model_lhi_integration_job"/>
            <field name="state">code</field>
            <field name="code">model.process_jobs()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
