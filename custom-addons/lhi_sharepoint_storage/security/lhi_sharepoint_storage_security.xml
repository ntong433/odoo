<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_lhi_document_item_company" model="ir.rule">
            <field name="name">SharePoint Documents: Multi-Company</field>
            <field name="model_id" ref="model_lhi_document_item"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('lhi_security.group_lhi_erp_admin')), (4, ref('lhi_security.group_lhi_integration_service')), (4, ref('lhi_security.group_lhi_internal_auditor'))]"/>
        </record>

        <record id="rule_lhi_document_storage_policy_company" model="ir.rule">
            <field name="name">SharePoint Storage Policies: Multi-Company</field>
            <field name="model_id" ref="model_lhi_document_storage_policy"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('lhi_security.group_lhi_erp_admin')), (4, ref('lhi_security.group_lhi_integration_service')), (4, ref('lhi_security.group_lhi_internal_auditor'))]"/>
        </record>
    </data>
</odoo>

