    </record>

    <!-- ==================== LHI ACTIVITY ==================== -->
    <record id="view_lhi_activity_tree" model="ir.ui.view">
        <field name="name">lhi.activity.tree</field>
        <field name="model">lhi.activity</field>
        <field name="arch" type="xml">
            <list string="Activities" decoration-muted="not active">
                <field name="code"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="output_code"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_lhi_activity_form" model="ir.ui.view">
        <field name="name">lhi.activity.form</field>
        <field name="model">lhi.activity</field>
        <field name="arch" type="xml">
            <form string="Activity / Output Code">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Drilling of Boreholes"/></h1>
                    </div>
                    <group>
                        <group string="Structure">
                            <field name="code"/>
                            <field name="project_id"/>
                            <field name="output_code"/>
                        </group>
                        <group string="Controls &amp; Validity">
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_lhi_activity_search" model="ir.ui.view">
        <field name="name">lhi.activity.search</field>
        <field name="model">lhi.activity</field>
        <field name="arch" type="xml">
            <search string="Search Activities &amp; Outputs">
                <field name="name"/>
                <field name="code"/>
                <field name="project_id"/>
                <field name="output_code"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <filter name="active_now" string="Currently Active" domain="[('active', '=', True)]"/>
                <group>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_lhi_activity" model="ir.actions.act_window">
        <field name="name">Activities &amp; Outputs</field>
        <field name="res_model">lhi.activity</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_lhi_activity_search"/>
    </record>

    <!-- ==================== MENU ITEMS LINKAGE ==================== -->
    <!-- Place under Operations parent menu in lhi_base -->
    <menuitem id="menu_lhi_office_item" name="Offices / Locations" parent="menu_lhi_operations" action="action_lhi_office" sequence="10"/>
    <menuitem id="menu_lhi_department_item" name="Departments &amp; Units" parent="menu_lhi_operations" action="action_lhi_department" sequence="20"/>
    <menuitem id="menu_lhi_programme_item" name="Programmes" parent="menu_lhi_operations" action="action_lhi_programme" sequence="30"/>
    <menuitem id="menu_lhi_sector_item" name="Technical Sectors" parent="menu_lhi_operations" action="action_lhi_sector" sequence="40"/>
    <menuitem id="menu_lhi_donor_item" name="Donors" parent="menu_lhi_operations" action="action_lhi_donor" sequence="50"/>
    <menuitem id="menu_lhi_funding_source_item" name="Funding Sources" parent="menu_lhi_operations" action="action_lhi_funding_source" sequence="60"/>
    <menuitem id="menu_lhi_award_item" name="Award Codes" parent="menu_lhi_operations" action="action_lhi_award" sequence="70"/>
    <menuitem id="menu_lhi_project_item" name="Project Codes" parent="menu_lhi_operations" action="action_lhi_project" sequence="80"/>
    <menuitem id="menu_lhi_cost_center_item" name="Cost Centres" parent="menu_lhi_operations" action="action_lhi_cost_center" sequence="90"/>
    <menuitem id="menu_lhi_activity_item" name="Activities / Outputs" parent="menu_lhi_operations" action="action_lhi_activity" sequence="100"/>
</odoo>
