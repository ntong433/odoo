<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_lhi_erp" model="ir.module.category">
        <field name="name">LHI ERP</field>
        <field name="description">Access levels for LHI ERP applications</field>
        <field name="sequence">100</field>
    </record>

    <record id="res_groups_privilege_lhi_erp" model="res.groups.privilege">
        <field name="name">LHI ERP Access</field>
        <field name="category_id" ref="module_category_lhi_erp"/>
    </record>

    <!-- Base User and Manager Groups (Keep xml_ids for backward compatibility with tests) -->
    <record id="group_lhi_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_lhi_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Specific LHI Roles -->
    <record id="group_lhi_employee" model="res.groups">
        <field name="name">LHI Employee</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_user'))]"/>
    </record>

    <record id="group_lhi_supervisor" model="res.groups">
        <field name="name">LHI Supervisor</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_employee'))]"/>
    </record>

    <record id="group_lhi_project_officer" model="res.groups">
        <field name="name">LHI Project Officer</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_employee'))]"/>
    </record>

    <record id="group_lhi_project_manager" model="res.groups">
        <field name="name">LHI Project Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_project_officer'))]"/>
    </record>

    <record id="group_lhi_programme_director" model="res.groups">
        <field name="name">LHI Programme Director</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_project_manager'))]"/>
    </record>

    <record id="group_lhi_meal_officer" model="res.groups">
        <field name="name">LHI MEAL Officer</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_employee'))]"/>
    </record>

    <record id="group_lhi_procurement_officer" model="res.groups">
        <field name="name">LHI Procurement Officer</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_employee'))]"/>
    </record>

    <record id="group_lhi_procurement_manager" model="res.groups">
        <field name="name">LHI Procurement Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_procurement_officer'))]"/>
    </record>

    <record id="group_lhi_store_officer" model="res.groups">
        <field name="name">LHI Store Officer</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_employee'))]"/>
    </record>

    <record id="group_lhi_fleet_officer" model="res.groups">
        <field name="name">LHI Fleet Officer</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_employee'))]"/>
    </record>

    <record id="group_lhi_finance_reviewer" model="res.groups">
        <field name="name">LHI Finance Reviewer</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_employee'))]"/>
    </record>

    <record id="group_lhi_hr_officer" model="res.groups">
        <field name="name">LHI HR Officer</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_employee'))]"/>
    </record>

    <record id="group_lhi_internal_auditor" model="res.groups">
        <field name="name">LHI Internal Auditor</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_employee'))]"/>
    </record>

    <record id="group_lhi_executive_approver" model="res.groups">
        <field name="name">LHI Executive Approver</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_employee'))]"/>
    </record>

    <record id="group_lhi_erp_admin" model="res.groups">
        <field name="name">LHI ERP Administrator</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids"
               eval="[(4, ref('group_lhi_manager')),
                      (4, ref('group_lhi_employee'))]"/>
        <field name="user_ids"
               eval="[(4, ref('base.user_root')),
                      (4, ref('base.user_admin'))]"/>
    </record>

    <record id="group_lhi_integration_service" model="res.groups">
        <field name="name">LHI Integration Service Account</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_employee'))]"/>
    </record>

    <!-- Operational roles. These roles resolve entirely through res.users and
         never require an hr.employee record. -->
    <record id="group_lhi_hub_viewer" model="res.groups">
        <field name="name">HUB Viewer</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_employee'))]"/>
    </record>

    <record id="group_lhi_warehouse_officer" model="res.groups">
        <field name="name">Warehouse Officer</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids"
               eval="[(4, ref('group_lhi_hub_viewer')),
                      (4, ref('group_lhi_store_officer'))]"/>
    </record>

    <record id="group_lhi_operations_officer" model="res.groups">
        <field name="name">Operations Officer</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_hub_viewer'))]"/>
    </record>

    <record id="group_lhi_operations_manager" model="res.groups">
        <field name="name">Operations Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids"
               eval="[(4, ref('group_lhi_warehouse_officer')),
                      (4, ref('group_lhi_operations_officer'))]"/>
    </record>

    <record id="group_lhi_director_operations" model="res.groups">
        <field name="name">Director of Operations</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_operations_manager'))]"/>
    </record>

    <record id="group_lhi_ned" model="res.groups">
        <field name="name">National Executive Director</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_executive_approver'))]"/>
    </record>

    <record id="group_lhi_asset_officer" model="res.groups">
        <field name="name">Asset Officer</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_employee'))]"/>
    </record>

    <record id="group_lhi_asset_manager" model="res.groups">
        <field name="name">Asset Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_asset_officer'))]"/>
    </record>

    <record id="group_lhi_programme_user" model="res.groups">
        <field name="name">Programme User</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_project_officer'))]"/>
    </record>

    <record id="group_lhi_programme_approver" model="res.groups">
        <field name="name">Programme Approver</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_project_manager'))]"/>
    </record>

    <record id="group_lhi_system_auditor" model="res.groups">
        <field name="name">System Auditor</field>
        <field name="privilege_id" ref="res_groups_privilege_lhi_erp"/>
        <field name="implied_ids" eval="[(4, ref('group_lhi_internal_auditor'))]"/>
    </record>
</odoo>
