<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_media_request_form" model="ir.ui.view">
        <field name="name">lhi.media.request.form</field>
        <field name="model">lhi.media.request</field>
        <field name="arch" type="xml">
            <form string="Media Request">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,comm_review,consent_review,approved,assigned,in_progress,completed,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                        <h2>
                            <field name="title" placeholder="Request Title..."/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="requesting_unit_id"/>
                            <field name="requested_by_id"/>
                            <field name="work_context"/>
                            <field name="activity_type"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="requested_date"/>
                            <field name="required_completion_date"/>
                            <field name="assigned_officer_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Details" name="details">
                            <group>
                                <field name="purpose"/>
                                <field name="target_audience"/>
                                <field name="location"/>
                                <field name="key_message"/>
                                <field name="donor_branding_requirements"/>
                            </group>
                        </page>
                        <page string="Project &amp; Links" name="links">
                            <group>
                                <field name="project_id" invisible="work_context != 'project_linked'" required="work_context == 'project_linked'"/>
                                <field name="task_id" domain="[('project_id', '=', project_id)]" invisible="work_context != 'project_linked'"/>
                                <field name="workplan_activity_id" invisible="work_context != 'project_linked'"/>
                                <field name="grant_id" invisible="work_context != 'project_linked'"/>
                            </group>
                        </page>
                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_lhi_media_request_list" model="ir.ui.view">
        <field name="name">lhi.media.request.list</field>
        <field name="model">lhi.media.request</field>
        <field name="arch" type="xml">
            <list string="Media Requests">
                <field name="name"/>
                <field name="title"/>
                <field name="activity_type"/>
                <field name="requesting_unit_id"/>
                <field name="requested_by_id"/>
                <field name="project_id"/>
                <field name="required_completion_date"/>
                <field name="state" widget="badge" decoration-info="state in ('submitted','comm_review','consent_review','assigned')" decoration-success="state in ('completed','closed')" decoration-danger="state in ('rejected','cancelled')"/>
            </list>
        </field>
    </record>

    <record id="action_lhi_media_request" model="ir.actions.act_window">
        <field name="name">Media Requests</field>
        <field name="res_model">lhi.media.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Media Request
            </p>
        </field>
    </record>

    <!-- Additional Contextual Actions for Menus -->
    <record id="action_lhi_media_donor_visibility" model="ir.actions.act_window">
        <field name="name">Donor Visibility</field>
        <field name="res_model">lhi.media.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('activity_type', '=', 'donor_visibility')]</field>
        <field name="context">{'default_activity_type': 'donor_visibility'}</field>
    </record>

    <record id="action_lhi_media_radio_tv" model="ir.actions.act_window">
        <field name="name">Radio and TV Engagements</field>
        <field name="res_model">lhi.media.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('activity_type', 'in', ('radio', 'interview'))]</field>
    </record>

    <record id="action_lhi_media_outreach_events" model="ir.actions.act_window">
        <field name="name">Outreach and Events</field>
        <field name="res_model">lhi.media.request</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('activity_type', 'in', ('outreach', 'event'))]</field>
    </record>
    
    <record id="action_lhi_media_consent_records" model="ir.actions.act_window">
        <field name="name">Consent Records</field>
        <field name="res_model">lhi.media.asset</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('asset_type', '=', 'consent')]</field>
        <field name="context">{'default_asset_type': 'consent'}</field>
    </record>
</odoo>
