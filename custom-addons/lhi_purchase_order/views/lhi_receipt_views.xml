<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_receipt_form" model="ir.ui.view">
        <field name="name">lhi.receipt.form</field>
        <field name="model">lhi.receipt</field>
        <field name="arch" type="xml">
            <form string="Goods / Service Receipt">
                <header>
                    <button name="action_validate" string="Validate" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="order_id"/>
                            <field name="vendor_id"/>
                        </group>
                        <group>
                            <field name="receipt_type"/>
                            <field name="date_done"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Receipt Lines">
                            <field name="line_ids">
                                <list string="Lines" editable="bottom">
                                    <field name="order_line_id" domain="[('order_id', '=', parent.order_id)]"/>
                                    <field name="name"/>
                                    <field name="qty_ordered"/>
                                    <field name="qty_received"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_lhi_receipt_tree" model="ir.ui.view">
        <field name="name">lhi.receipt.tree</field>
        <field name="model">lhi.receipt</field>
        <field name="arch" type="xml">
            <list string="Receipts">
                <field name="name"/>
                <field name="order_id"/>
                <field name="vendor_id"/>
                <field name="receipt_type"/>
                <field name="date_done"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
</odoo>
