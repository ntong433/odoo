<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_meal_data_graph" model="ir.ui.view">
        <field name="name">lhi.meal.data.graph</field>
        <field name="model">lhi.meal.data</field>
        <field name="arch" type="xml">
            <graph string="MEAL Performance Dashboard" type="bar">
                <field name="indicator_id" type="row"/>
                <field name="date_reported" interval="month" type="col"/>
                <field name="achieved_value" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_lhi_meal_data_pivot" model="ir.ui.view">
        <field name="name">lhi.meal.data.pivot</field>
        <field name="model">lhi.meal.data</field>
        <field name="arch" type="xml">
            <pivot string="MEAL Analytics Pivot" display_quantity="true">
                <field name="indicator_id" type="row"/>
                <field name="location_id" type="col"/>
                <field name="achieved_value" type="measure"/>
            </pivot>
        </field>
    </record>
</odoo>
