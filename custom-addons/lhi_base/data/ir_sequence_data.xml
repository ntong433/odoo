<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_lhi_award" model="ir.sequence">
        <field name="name">LHI Award Sequence</field>
        <field name="code">lhi.award</field>
        <field name="prefix">LHI/AWRD/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_lhi_project" model="ir.sequence">
        <field name="name">LHI Project Sequence</field>
        <field name="code">lhi.project</field>
        <field name="prefix">LHI/PROJ/%(year)s/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
