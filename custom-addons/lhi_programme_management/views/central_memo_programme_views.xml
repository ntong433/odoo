<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_memo_programme_context"
            model="ir.ui.view">
        <field name="name">lhi.memo.form.programme.context</field>
        <field name="model">lhi.memo</field>
        <field name="inherit_id"
               ref="lhi_memo_management.view_lhi_memo_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='project_id']"
                   position="after">

                <field name="workplan_activity_id"
                       domain="[('project_id', '=', project_id)]"
                       invisible="work_context != 'project_linked'"
                       readonly="state not in ('draft', 'authoring', 'returned', 'failed')"/>

                <field name="project_budget_line_id"
                       domain="[('budget_id.project_id', '=', project_id)]"
                       invisible="work_context != 'project_linked'"
                       readonly="state not in ('draft', 'authoring', 'returned', 'failed')"/>

            </xpath>

        </field>
    </record>
</odoo>
