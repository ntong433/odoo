<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="asset_condition_new" model="lhi.asset.condition">
            <field name="name">New</field>
            <field name="code">new</field>
            <field name="sequence">10</field>
        </record>
        <record id="asset_condition_good" model="lhi.asset.condition">
            <field name="name">Good</field>
            <field name="code">good</field>
            <field name="sequence">20</field>
        </record>
        <record id="asset_condition_fair" model="lhi.asset.condition">
            <field name="name">Fair</field>
            <field name="code">fair</field>
            <field name="sequence">30</field>
        </record>
        <record id="asset_condition_damaged" model="lhi.asset.condition">
            <field name="name">Damaged</field>
            <field name="code">damaged</field>
            <field name="sequence">40</field>
        </record>
        <record id="asset_condition_under_repair" model="lhi.asset.condition">
            <field name="name">Under Repair</field>
            <field name="code">under_repair</field>
            <field name="sequence">50</field>
        </record>
        <record id="asset_condition_unserviceable" model="lhi.asset.condition">
            <field name="name">Unserviceable</field>
            <field name="code">unserviceable</field>
            <field name="sequence">60</field>
        </record>

        <record id="asset_tag_rule_main_company" model="lhi.asset.tag.rule">
            <field name="name">LHI Standard Asset Tag</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="organisation_prefix">LHI</field>
            <field name="lhi_owner_code">LHI</field>
            <field name="separator">/</field>
            <field name="padding">4</field>
            <field name="sequence_strategy">global</field>
            <field name="is_default" eval="True"/>
        </record>

        <record id="policy_asset_import_batch" model="lhi.document.storage.policy">
            <field name="name">Asset Import Source and Error Reports</field>
            <field name="model_name">lhi.asset.import.batch</field>
            <field name="library_code">operations</field>
            <field name="folder_strategy">model_record</field>
            <field name="document_category">Asset Import</field>
            <field name="retention_category">Operational</field>
            <field name="confidentiality">restricted</field>
            <field name="direct_browser_upload" eval="False"/>
        </record>
    </data>
</odoo>
