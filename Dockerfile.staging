FROM debian:bookworm-slim

# Install system dependencies needed for Odoo and standard tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libxml2-dev \
    libxslt1-dev \
    libevent-dev \
    libsasl2-dev \
    libldap2-dev \
    libpq-dev \
    libjpeg-dev \
    libpng-dev \
    ghostscript \
    git \
    curl \
    postgresql-client \
    python3 \
    python3-pip \
    python3-dev \
    python3-lxml \
    python3-gevent \
    python3-psycopg2 \
    python3-pil \
    python3-cryptography \
    python3-openssl \
    python3-cffi \
    python3-greenlet \
    python3-markupsafe \
    python3-reportlab \
    python3-pypdf2 \
    python3-dateutil \
    python3-tz \
    python3-requests \
    python3-urllib3 \
    python3-babel \
    python3-passlib \
    python3-werkzeug \
    python3-jinja2 \
    python3-docutils \
    && rm -rf /var/lib/apt/lists/*

# Create Odoo home directory and user
RUN useradd -m -U -s /bin/bash odoo
WORKDIR /opt/odoo

# Copy Odoo dependencies
COPY odoo/requirements.txt /tmp/requirements.txt

# Install remaining requirements via pip, using system packages where possible
RUN pip3 install --no-cache-dir --break-system-packages -r /tmp/requirements.txt

# Copy source and custom addons
COPY odoo /opt/odoo
COPY custom-addons /opt/odoo/custom-addons
COPY scripts /opt/odoo/scripts
COPY odoo.conf /etc/odoo/odoo.conf

# Only runtime data and log directories need to be writable by Odoo. Keeping
# application source root-owned avoids an expensive recursive chown over the
# full Odoo tree during every Coolify image build.
RUN mkdir -p /var/lib/odoo /var/log/odoo && \
    chmod 0755 \
        /opt/odoo/scripts/validate_microsoft_env.sh \
        /opt/odoo/scripts/start_odoo.sh && \
    chown -R odoo:odoo /var/lib/odoo /var/log/odoo

USER odoo

EXPOSE 8069 8072
