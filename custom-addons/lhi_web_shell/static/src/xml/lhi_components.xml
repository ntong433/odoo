<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Theme Toggle Systray Item -->
    <t t-name="lhi_web_shell.ThemeToggle" owl="1">
        <button class="lhi-theme-toggle border-0 bg-transparent p-2 d-flex align-items-center" 
                t-on-click="toggleTheme"
                t-att-title="'Theme: ' + (theme.theme === 'dark' ? 'Dark' : (theme.theme === 'light' ? 'Light' : 'System'))"
                aria-label="Toggle theme">
            <i t-attf-class="fa fa-lg {{ theme.theme === 'dark' ? 'fa-moon-o' : (theme.theme === 'light' ? 'fa-sun-o' : 'fa-laptop') }}" 
               t-att-style="theme.isDark ? 'color: #f59e0b;' : 'color: var(--lhi-text-muted);'"></i>
        </button>
    </t>

    <!-- Notification Badge Systray Item -->
    <t t-name="lhi_web_shell.NotificationBadge" owl="1">
        <button class="lhi-topbar__icon-btn" 
                title="Notifications"
                aria-label="View notifications">
            <i class="fa fa-lg fa-bell-o"></i>
            <!-- Placeholder pulse dot for pending actions/notifications -->
            <span class="lhi-badge-dot"></span>
        </button>
    </t>

    <!-- Sidebar Component Template -->
    <t t-name="lhi_web_shell.Sidebar" owl="1">
        <aside class="lhi-sidebar" t-att-class="{ 'lhi-sidebar--collapsed': state.collapsed }">
            <div class="lhi-sidebar__brand">
                <img src="/web/binary/company_logo" class="lhi-sidebar__logo" alt="LHI Nigeria Logo" onerror="this.src='/web/static/img/favicon.ico'"/>
                <div class="lhi-sidebar__org-name">Life Helpers Initiative</div>
            </div>
            
            <div class="lhi-sidebar__nav">
                <!-- Pinned Dashboard -->
                <a t-attf-class="lhi-sidebar__item {{ state.activeAppId === 'dashboard' ? 'lhi-sidebar__item--active' : '' }}"
                   t-on-click="() => this.onAppClick({ id: 'dashboard' })"
                   title="Dashboard">
                    <i class="fa fa-th-large lhi-sidebar__icon"></i>
                    <span class="lhi-sidebar__label">Dashboard</span>
                </a>

                <div class="lhi-sidebar__section-label">Apps</div>
                <t t-foreach="apps" t-as="app" t-key="app.id">
                    <a t-attf-class="lhi-sidebar__item {{ state.activeAppId === app.id ? 'lhi-sidebar__item--active' : '' }}"
                       t-on-click="() => this.onAppClick(app)"
                       t-att-title="app.name">
                        <t t-set="icon" t-value="getIconProps(app)"/>
                        <t t-if="icon.type === 'fa'">
                            <i t-attf-class="{{icon.class}} lhi-sidebar__icon"></i>
                        </t>
                        <t t-else="">
                            <img t-att-src="icon.src" class="lhi-sidebar__icon lhi-sidebar__icon-img" alt=""/>
                        </t>
                        <span class="lhi-sidebar__label" t-esc="app.name"></span>
                    </a>
                </t>
            </div>
            
            <div class="lhi-sidebar__footer">
                <button class="lhi-sidebar__item lhi-sidebar__utility border-0 bg-transparent"
                        type="button"
                        t-on-click="onPreferencesClick"
                        title="Preferences">
                    <i class="fa fa-cog lhi-sidebar__icon"></i>
                    <span class="lhi-sidebar__label">Preferences</span>
                </button>
                <button class="lhi-sidebar__collapse-btn" t-on-click="toggleCollapse" t-att-title="state.collapsed ? 'Expand' : 'Collapse'">
                    <i t-attf-class="fa {{ state.collapsed ? 'fa-chevron-right' : 'fa-chevron-left' }}"></i>
                    <span class="lhi-sidebar__label" t-if="!state.collapsed">Collapse</span>
                </button>
            </div>
        </aside>
    </t>

    <!-- Inject Sidebar into WebClient as first child of the CSS grid -->
    <t t-inherit="web.WebClient" t-inherit-mode="extension">
        <!--
            The .o_web_client div is a CSS Grid with two columns:
              column 1: lhi sidebar width variable  → occupied by .lhi-sidebar
              column 2: minmax(0, 1fr)             → all Odoo-native children (topbar, action manager)

            We prepend the sidebar so it occupies column 1.
            All other children automatically flow into column 2 via shell SCSS rules.
        -->
        <xpath expr="//NavBar" position="before">
            <LhiSidebar/>
        </xpath>
    </t>


</templates>
