<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_document_template_list" model="ir.ui.view">
        <field name="name">lhi.document.template.list</field>
        <field name="model">lhi.document.template</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'approved'" decoration-danger="state == 'invalid'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_name"/>
                <field name="file_type"/>
                <field name="source_name"/>
                <field name="source_size" widget="file_size"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_lhi_document_template_form" model="ir.ui.view">
        <field name="name">lhi.document.template.form</field>
        <field name="model">lhi.document.template</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validate_and_approve"
                            type="object"
                            string="Validate and Approve"
                            class="btn-primary"
                            groups="lhi_security.group_lhi_erp_admin"
                            invisible="state == 'approved'"/>
                    <button name="action_disable"
                            type="object"
                            string="Disable"
                            groups="lhi_security.group_lhi_erp_admin"
                            invisible="state == 'disabled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="company_id"/>
                            <field name="model_name"/>
                            <field name="file_type"/>
                            <field name="graph_connection_id"/>
                        </group>
                        <group string="Approved SharePoint Source">
                            <field name="source_drive_id"/>
                            <field name="source_item_id"/>
                            <field name="source_name" readonly="1"/>
                            <field name="source_mime_type" readonly="1"/>
                            <field name="source_size" readonly="1" widget="file_size"/>
                            <field name="validated_at" readonly="1"/>
                            <field name="validated_by_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Diagnostics" invisible="not last_error">
                        <field name="last_error" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_lhi_document_template" model="ir.actions.act_window">
        <field name="name">Office Document Templates</field>
        <field name="res_model">lhi.document.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
