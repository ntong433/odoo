<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_opensign_request_form" model="ir.ui.view">
        <field name="name">lhi.opensign.request.form</field>
        <field name="model">lhi.opensign.request</field>
        <field name="arch" type="xml">
            <form string="OpenSign Request">
                <header>
                    <button name="action_send" string="Send" type="object" class="oe_highlight" invisible="status != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="status in ('completed', 'cancelled')"/>
                    <button name="action_download_source_document" string="Open Source" type="object" invisible="not source_stored"/>
                    <button name="action_download_signed_document" string="Open Signed PDF" type="object" invisible="not signed_stored"/>
                    <button name="action_download_audit_certificate" string="Open Certificate" type="object" invisible="not certificate_stored"/>
                    <field name="status" widget="statusbar" statusbar_visible="draft,sent,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="sequence_type"/>
                            <field name="expiry_date"/>
                        </group>
                        <group>
                            <field name="source_pdf" filename="source_pdf_name"/>
                            <field name="source_pdf_hash"/>
                            <field name="signed_pdf"/>
                            <field name="signed_pdf_hash"/>
                            <field name="audit_certificate"/>
                            <field name="source_stored" invisible="1"/>
                            <field name="signed_stored" invisible="1"/>
                            <field name="certificate_stored" invisible="1"/>
                            <field name="source_document_item_id" readonly="1" groups="lhi_security.group_lhi_erp_admin"/>
                            <field name="signed_document_item_id" readonly="1" groups="lhi_security.group_lhi_erp_admin"/>
                            <field name="certificate_document_item_id" readonly="1" groups="lhi_security.group_lhi_erp_admin"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Signatories">
                            <field name="signatories"/>
                        </page>
                        <page string="Logs &amp; Callbacks">
                            <group>
                                <field name="retry_count"/>
                                <field name="error_message"/>
                            </group>
                            <field name="callback_logs"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_lhi_opensign_request_tree" model="ir.ui.view">
        <field name="name">lhi.opensign.request.tree</field>
        <field name="model">lhi.opensign.request</field>
        <field name="arch" type="xml">
            <list string="OpenSign Requests">
                <field name="name"/>
                <field name="res_model"/>
                <field name="status" widget="badge"/>
                <field name="expiry_date"/>
            </list>
        </field>
    </record>
    
    <record id="action_lhi_opensign_request" model="ir.actions.act_window">
        <field name="name">OpenSign Requests</field>
        <field name="res_model">lhi.opensign.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_lhi_opensign" name="OpenSign Integration" parent="lhi_purchase_request.menu_lhi_procurement_root" action="action_lhi_opensign_request" sequence="80"/>
    <menuitem id="menu_lhi_opensign_requests" name="Signature Requests" parent="menu_lhi_opensign" action="action_lhi_opensign_request" sequence="10"/>
</odoo>
