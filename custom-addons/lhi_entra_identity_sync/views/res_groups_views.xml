<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_groups_form_lhi_entra_identity_sync" model="ir.ui.view">
        <field name="name">res.groups.form.lhi.entra.identity.sync</field>
        <field name="model">res.groups</field>
        <field name="inherit_id" ref="base.view_groups_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="lhi_entra_management_mode" readonly="1"/>
                <field name="lhi_entra_mapping_count" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>

