<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_document_storage_policy_list" model="ir.ui.view">
        <field name="name">lhi.document.storage.policy.list</field>
        <field name="model">lhi.document.storage.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="model_name"/>
                <field name="field_name"/>
                <field name="storage_backend"/>
                <field name="library_code"/>
                <field name="folder_strategy"/>
                <field name="direct_browser_upload"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_lhi_document_storage_policy_form" model="ir.ui.view">
        <field name="name">lhi.document.storage.policy.form</field>
        <field name="model">lhi.document.storage.policy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active"/>
                            <field name="sequence"/>
                            <field name="company_id"/>
                            <field name="model_name"/>
                            <field name="field_name"/>
                            <field name="storage_backend"/>
                        </group>
                        <group>
                            <field name="library_code"/>
                            <field name="folder_strategy"/>
                            <field name="fixed_folder_path" invisible="folder_strategy != 'fixed_path'"/>
                            <field name="project_subfolder" invisible="folder_strategy != 'project_workspace'"/>
                            <field name="document_category"/>
                            <field name="confidentiality"/>
                            <field name="retention_category"/>
                        </group>
                    </group>
                    <group string="Upload Controls">
                        <field name="maximum_size_mb"/>
                        <field name="small_upload_limit_mb"/>
                        <field name="upload_chunk_size_kb"/>
                        <field name="allowed_extensions"/>
                        <field name="conflict_behavior"/>
                        <field name="direct_browser_upload"/>
                        <field name="required_metadata_json"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lhi_document_storage_policy" model="ir.actions.act_window">
        <field name="name">Document Storage Policies</field>
        <field name="res_model">lhi.document.storage.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

