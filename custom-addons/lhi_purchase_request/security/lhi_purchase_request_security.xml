<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_lhi_purchase_request_company" model="ir.rule">
            <field name="name">Purchase Request: Multi-Company</field>
            <field name="model_id" ref="model_lhi_purchase_request"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_lhi_budget_line_company" model="ir.rule">
            <field name="name">Operational Budget Line: Multi-Company</field>
            <field name="model_id" ref="model_lhi_budget_line"/>
            <field name="domain_force">
                [('company_id', 'in', company_ids)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
