<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_feature_flag_tree" model="ir.ui.view">
        <field name="name">lhi.feature.flag.tree</field>
        <field name="model">lhi.feature.flag</field>
        <field name="arch" type="xml">
            <list string="LHI Feature Flags" decoration-success="is_enabled" decoration-danger="not is_enabled">
                <field name="name"/>
                <field name="description"/>
                <field name="is_enabled"/>
            </list>
        </field>
    </record>

    <record id="view_lhi_feature_flag_form" model="ir.ui.view">
        <field name="name">lhi.feature.flag.form</field>
        <field name="model">lhi.feature.flag</field>
        <field name="arch" type="xml">
            <form string="LHI Feature Flag">
                <header>
                    <button name="action_enable" type="object" string="Enable Feature" class="btn-primary" invisible="is_enabled"/>
                    <button name="action_disable" type="object" string="Disable Feature" class="btn-secondary" invisible="not is_enabled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="description"/>
                        <field name="is_enabled" readonly="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_lhi_feature_flag" model="ir.actions.act_window">
        <field name="name">Feature Flags</field>
        <field name="res_model">lhi.feature.flag</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_lhi_feature_flag" name="Feature Flags" parent="lhi_base.menu_lhi_root" action="action_lhi_feature_flag" sequence="80" groups="base.group_system"/>
</odoo>
