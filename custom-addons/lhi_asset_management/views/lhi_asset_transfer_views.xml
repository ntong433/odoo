<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_asset_transfer_form" model="ir.ui.view">
        <field name="name">lhi.asset.transfer.form</field>
        <field name="model">lhi.asset.transfer</field>
        <field name="arch" type="xml">
            <form string="Asset Transfer">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'submitted'"/>
                    <button name="action_complete" string="Complete Transfer" type="object" class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('completed', 'cancel')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,completed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="asset_id" readonly="state != 'draft'"/>
                            <field name="transfer_type" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group string="From">
                            <field name="source_custodian_id"/>
                            <field name="source_location_id"/>
                        </group>
                        <group string="To">
                            <field name="dest_custodian_id" invisible="transfer_type not in ('handover', 'location')" required="transfer_type == 'handover'"/>
                            <field name="dest_location_id" invisible="transfer_type not in ('location')" required="transfer_type == 'location'"/>
                        </group>
                    </group>
                    <group string="Justification">
                        <field name="justification" nolabel="1" readonly="state != 'draft'"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_lhi_asset_transfer_tree" model="ir.ui.view">
        <field name="name">lhi.asset.transfer.tree</field>
        <field name="model">lhi.asset.transfer</field>
        <field name="arch" type="xml">
            <list string="Asset Transfers">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="transfer_type"/>
                <field name="source_custodian_id"/>
                <field name="dest_custodian_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
</odoo>
