            <field name="domain_force">[('id', 'in', user.lhi_project_ids.ids)] if user.lhi_project_ids else [(1, '=', 1)]</field>
        </record>

        <!-- Project Bypass for LHI Managers -->
        <record id="rule_lhi_project_manager_bypass" model="ir.rule">
