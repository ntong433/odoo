<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_lhi_asset" model="ir.sequence">
            <field name="name">Asset Tag</field>
            <field name="code">lhi.asset</field>
            <field name="prefix">AST/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_lhi_asset_transfer" model="ir.sequence">
            <field name="name">Asset Transfer Reference</field>
            <field name="code">lhi.asset.transfer</field>
            <field name="prefix">TRF/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
