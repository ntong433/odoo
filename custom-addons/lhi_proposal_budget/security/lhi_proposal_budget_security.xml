<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Multi-company record rules -->
        <record id="rule_lhi_proposal_budget_company" model="ir.rule">
            <field name="name">Proposal Budget: Multi-Company</field>
            <field name="model_id" ref="model_lhi_proposal_budget"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="groups" eval="[(4, ref('lhi_security.group_lhi_programme_viewer'))]"/>
        </record>
        
        <record id="rule_lhi_proposal_submission_company" model="ir.rule">
            <field name="name">Proposal Submission: Multi-Company</field>
            <field name="model_id" ref="model_lhi_proposal_submission"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
            <field name="groups" eval="[(4, ref('lhi_security.group_lhi_programme_viewer'))]"/>
        </record>
    </data>
</odoo>
