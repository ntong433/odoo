<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lhi_funding_stage_form" model="ir.ui.view">
        <field name="name">lhi.funding.stage.form</field>
        <field name="model">lhi.funding.stage</field>
        <field name="arch" type="xml">
            <form string="Opportunity Stage">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="is_won"/>
                            <field name="is_lost"/>
                            <field name="fold"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_lhi_funding_stage_tree" model="ir.ui.view">
        <field name="name">lhi.funding.stage.tree</field>
        <field name="model">lhi.funding.stage</field>
        <field name="arch" type="xml">
            <list string="Stages">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_won"/>
                <field name="fold"/>
            </list>
        </field>
    </record>

    <record id="action_lhi_funding_stage" model="ir.actions.act_window">
        <field name="name">Pipeline Stages</field>
        <field name="res_model">lhi.funding.stage</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
