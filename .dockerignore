# First, exclude everything by default
**

# Next, explicitly include only what we need
!Dockerfile.dev
!Dockerfile.staging
!.dockerignore
!odoo.conf
!odoo/
!odoo/**
!custom-addons/
!custom-addons/**
!scripts/
!scripts/**

# FINALLY, exclude sensitive/generated/huge directories that might have been re-included above
.git
.git/**
odoo/.git
odoo/.git/**
**/.git
**/.git/**
.venv
.venv/**
**/.env
**/.env.*
**/lhi-sharepoint-identifiers.env
**/*.pem
**/*.pfx
**/*.key
**/__pycache__
**/__pycache__/**
**/*.py[co]
**/.pytest_cache
**/.pytest_cache/**
custom-addons/graphify-out
custom-addons/graphify-out/**
*.pdf
har_rpc.txt
har_urls.txt
keys.json
microsoft_login_completion_report.md
