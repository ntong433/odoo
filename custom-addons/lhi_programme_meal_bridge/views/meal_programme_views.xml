<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_meal_data_programme_context" model="ir.ui.view">
        <field name="name">lhi.meal.data.programme.context</field>
        <field name="model">lhi.meal.data</field>
        <field name="inherit_id" ref="lhi_meal.view_lhi_meal_data_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='location_id']" position="after">
                <field name="work_context"/>
                <field name="grant_id" invisible="work_context != 'project_linked'"/>
                <field name="memo_id" invisible="work_context != 'project_linked'"/>
                <field name="project_budget_line_id" invisible="work_context != 'project_linked'"/>
            </xpath>
        </field>
    </record>

    <record id="view_meal_initiative_programme_context" model="ir.ui.view">
        <field name="name">lhi.meal.initiative.programme.context</field>
        <field name="model">lhi.meal.initiative</field>
        <field name="inherit_id" ref="lhi_meal.view_lhi_meal_initiative_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='activity_id']" position="after">
                <field name="memo_id" invisible="work_context != 'project_linked'"/>
                <field name="project_budget_line_id" invisible="work_context != 'project_linked'"/>
            </xpath>
        </field>
    </record>
</odoo>
